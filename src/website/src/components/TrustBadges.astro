---
import { useTranslations } from '../i18n/utils';
import { formatCount, getAdoptionStats } from '../utils/adoption';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const stats = await getAdoptionStats();

// Only numbers the registries actually returned at build time
const proof = [
  {
    value: stats.githubStars,
    label: t.proof.stars,
    href: 'https://github.com/macalbert/envilder',
  },
  {
    value: stats.npmLastMonth,
    label: t.proof.npmMonthly,
    href: 'https://www.npmjs.com/package/envilder',
  },
  {
    value: stats.pypiLastMonth,
    label: t.proof.pypiMonthly,
    href: 'https://pypi.org/project/envilder/',
  },
  {
    value: stats.nugetTotal,
    label: t.proof.nugetTotal,
    href: 'https://www.nuget.org/packages/Envilder',
  },
].filter(
  (item): item is { value: number; label: string; href: string } =>
    item.value !== null && item.value > 0,
);
---

<section class="trust section-alt">
  <div class="container">
    <div class="trust-grid">

      <div class="trust-item">
        <img class="trust-logo" src="/AWS.svg" alt="AWS" width="24" height="24" loading="lazy" />
        <span class="trust-name">AWS SSM</span>
      </div>

      <span class="trust-sep" aria-hidden="true">·</span>

      <div class="trust-item">
        <img class="trust-logo" src="/Azure.svg" alt="Azure" width="24" height="24" loading="lazy" />
        <span class="trust-name">Azure Key Vault</span>
      </div>

      <span class="trust-sep" aria-hidden="true">·</span>

      <div class="trust-item">
        <img class="trust-logo" src="/GitHubActions.svg" alt="GitHub Actions" width="24" height="24" loading="lazy" />
        <span class="trust-name">GitHub Actions</span>
      </div>

      <span class="trust-sep" aria-hidden="true">·</span>

      <div class="trust-item">
        <img class="trust-logo" src="/NPM.svg" alt="npm" width="24" height="24" loading="lazy" />
        <span class="trust-name">npm</span>
      </div>

      <span class="trust-sep" aria-hidden="true">·</span>

      <div class="trust-item">
        <img class="trust-logo" src="/sdk-python.svg" alt="Python" width="24" height="24" loading="lazy" />
        <span class="trust-name">PyPI</span>
      </div>

      <span class="trust-sep" aria-hidden="true">·</span>

      <div class="trust-item">
        <img class="trust-logo" src="/sdk-dotnet.svg" alt=".NET" data-dark-logo width="24" height="24" loading="lazy" />
        <span class="trust-name">NuGet</span>
      </div>

    </div>

    <ul class="proof-list" aria-label={t.proof.ariaLabel}>
      {proof.map((item) => (
        <li>
          <a href={item.href} target="_blank" rel="noopener noreferrer" class="proof-item">
            <strong class="proof-value">{formatCount(item.value, lang)}</strong>
            <span class="proof-label">{item.label}</span>
          </a>
        </li>
      ))}
      <li>
        <a
          href="https://www.bestpractices.dev/projects/15703"
          target="_blank"
          rel="noopener noreferrer"
          class="proof-item"
        >
          <img
            class="proof-icon"
            src="/openssf-best-practices.svg"
            alt={t.proof.openssfBadge}
            width="20"
            height="20"
            loading="lazy"
            decoding="async"
          />
          <strong class="proof-value">{t.proof.openssfLevel}</strong>
          <span class="proof-label">{t.proof.openssfLabel}</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .trust {
    padding: var(--space-xl) 0;
    border-top: 2px solid var(--color-border);
    border-bottom: 2px solid var(--color-border);
  }

  .trust-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }

  .trust-sep {
    color: var(--color-border-light);
    font-size: 1.2rem;
    line-height: 1;
    user-select: none;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .trust-logo {
    width: 24px;
    height: 24px;
    opacity: 0.7;
    transition: opacity 0.2s ease;
    filter: grayscale(100%) sepia(60%) saturate(400%) hue-rotate(50deg) brightness(0.9);
  }

  .trust-logo[data-dark-logo] {
    filter: grayscale(100%) sepia(60%) saturate(400%) hue-rotate(50deg) brightness(2.6);
  }

  .trust-item:hover .trust-logo {
    opacity: 1;
  }

  :global([data-theme="light"]) .trust-logo,
  :global([data-theme="cream"]) .trust-logo {
    filter: grayscale(100%) sepia(40%) saturate(100%) brightness(0.7) contrast(1.1);
  }

  .trust-name {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .proof-list {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-2xl);
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
  }

  .proof-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .proof-item:hover .proof-value {
    color: var(--color-accent);
  }

  .proof-value {
    font-family: var(--font-pixel);
    font-size: 0.8rem;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }

  .proof-label {
    font-size: 0.85rem;
  }

  .proof-icon {
    align-self: center;
    width: 20px;
    height: 20px;
  }

  @media (max-width: 640px) {
    .trust-sep {
      display: none;
    }

    .trust-grid {
      gap: var(--space-md) var(--space-xl);
    }
  }
</style>
