---
import type { DocsArticleRouteKey } from '../i18n/docs-routes';
import { docsRouteManifest } from '../i18n/docs-routes';
import { localizedPath, useTranslations } from '../i18n/utils';
import CodeBlock from './CodeBlock.astro';
import DocsShell from './DocsShell.astro';

interface Props {
  lang: string;
  routeKey: DocsArticleRouteKey;
}

const { lang, routeKey } = Astro.props;
const t = useTranslations(lang);
const sdkDotnetVersion = `v${__SDK_DOTNET_VERSION__}`;
const sdkPythonVersion = `v${__SDK_PYTHON_VERSION__}`;
const sdkNodejsVersion = `v${__SDK_NODEJS_VERSION__}`;
const articleRoutes = docsRouteManifest.filter((route) => route.key !== 'hub');
const routeIndex = articleRoutes.findIndex((route) => route.key === routeKey);
const previousRoute = articleRoutes[routeIndex - 1];
const nextRoute = articleRoutes[routeIndex + 1];

const azRbacAssign = `az role assignment create \
  --role "Key Vault Secrets Officer" \
  --assignee {YOUR_OBJECT_ID} \
  --scope /subscriptions/{SUB}/resourceGroups/{RG}/providers/Microsoft.KeyVault/vaults/{VAULT}`;

const azVaultShow = `az keyvault show --name {VAULT_NAME} \
  --query properties.enableRbacAuthorization`;

const azVaultPolicy = `az keyvault set-policy \
  --name {VAULT_NAME} \
  --object-id {YOUR_OBJECT_ID} \
  --secret-permissions get set list`;

const pushSingleCmd =
  'envilder --key=API_KEY --value={SECRET} --secret-path=/myapp/api/key';

const execRootOptionError = `$ envilder --map=config/prod.json exec -- npm start
error: Put envilder options after "exec": envilder exec --map=config/prod.json -- npm …`;

const execRejectedOptions = [
  {
    option: '--envfile',
    message:
      '--envfile cannot be used with exec: exec mode never reads or writes a .env file.',
  },
  { option: '--push', message: '--push cannot be used with exec.' },
  {
    option: '--key, --value, --secret-path',
    message: 'Single-secret push options cannot be used with exec.',
  },
];

const execUcLocalstackMap = `{
  "LOCALSTACK_AUTH_TOKEN": "/envilder/development/localstack/authToken"
}`;

const execUcLocalstackCompose = `services:
  localstack:
    image: localstack/localstack:stable
    ports:
      - "4566:4566"
    environment:
      LOCALSTACK_AUTH_TOKEN: \${LOCALSTACK_AUTH_TOKEN}`;

const execUcLocalstackDocker =
  'envilder exec -- docker run --rm -e LOCALSTACK_AUTH_TOKEN -p 4566:4566 localstack/localstack:stable';

const execUcTests = `envilder exec -- npm test
envilder exec -- dotnet test
envilder exec -- pytest`;

const execUcMigrationsMap = `{
  "DATABASE_URL": "/my-app/development/database/url"
}`;

const execUcMigrations = `envilder exec -- npx prisma migrate deploy
envilder exec -- python scripts/backfill.py`;

const execUcTerraformMap = `{
  "TF_VAR_db_password": "/my-app/development/database/password"
}`;

const execUcDevPackageJson = `{
  "scripts": {
    "dev": "envilder exec -- next dev"
  }
}`;

const execUcGhaWorkflow = `permissions:
  id-token: write # Required for OIDC
  contents: read

steps:
  - uses: actions/checkout@v5
  - uses: aws-actions/configure-aws-credentials@v5
    with:
      role-to-assume: arn:aws:iam::123456789012:role/GitHubActionsRole
      aws-region: us-east-1
  - run: npx envilder exec -- npm test`;

const execUcChain = `envilder exec -- sh -c 'npm run migrate && exec npm start'
envilder exec -- bash`;

const execPackageJson = `{
  "scripts": {
    "dev": "envilder exec -- vite",
    "start": "envilder exec --map=config/prod.json -- node server.js"
  }
}`;

const awsVerifyCmd = `# 1. Create a test parameter
aws ssm put-parameter --name "/test/hello" --value "world" --type SecureString --overwrite

# 2. Create a minimal map file
echo '{ "HELLO": "/test/hello" }' > test-map.json

# 3. Pull with Envilder
envilder --map=test-map.json --envfile=.env`;

const azureVerifyCmd = `# 1. Create a test secret
az keyvault secret set --vault-name {VAULT_NAME} --name "test-hello" --value "world"

# 2. Create a minimal map file
echo '{ "$config": { "provider": "azure", "vaultUrl": "https://{VAULT_NAME}.vault.azure.net" }, "HELLO": "test-hello" }' > test-map.json

# 3. Pull with Envilder
envilder --map=test-map.json --envfile=.env`;

const ghaAwsTrustPolicy = `{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Principal": {
      "Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
    },
    "Action": "sts:AssumeRoleWithWebIdentity",
    "Condition": {
      "StringEquals": {
        "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
        "token.actions.githubusercontent.com:sub": "repo:my-org/my-repo:ref:refs/heads/main"
      }
    }
  }]
}`;

const ghaAwsReadPolicy = `{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Action": "ssm:GetParameter",
    "Resource": "arn:aws:ssm:eu-west-1:123456789012:parameter/myapp/prod/*"
  }]
}`;

const ghaExpectedOutput = `🔑 Envilder GitHub Action - Starting secret pull...
📋 Map file: envilder.json
📄 Env file: .env

☁ AWS identity · account=123456789012 · region=eu-west-1 · profile=default

🪙  RESOLVING SECRETS
${'━'.repeat(60)}
  ✓ DB_PASSWORD         → *****************x9Q
  ✓ STRIPE_KEY          → *****************************4Rt

⭐ LEVEL CLEARED  —  2/2 secrets loaded · .env written

✅ Secrets pulled successfully!`;

const ghaAzureFederated = `az ad app create --display-name github-envilder
az ad sp create --id {APP_ID}

az ad app federated-credential create --id {APP_ID} --parameters '{
  "name": "github-main",
  "issuer": "https://token.actions.githubusercontent.com",
  "subject": "repo:my-org/my-repo:ref:refs/heads/main",
  "audiences": ["api://AzureADTokenExchange"]
}'`;

const ghaAzureRole = `az role assignment create \\
  --role "Key Vault Secrets User" \\
  --assignee {APP_ID} \\
  --scope /subscriptions/{SUB}/resourceGroups/{RG}/providers/Microsoft.KeyVault/vaults/{VAULT}`;
---

<DocsShell lang={lang} routeKey={routeKey}>
  {routeKey === 'getting-started' && (
    <>
      <section id="overview" class="docs-section">
        <h2>{t.docs.overviewTitle}</h2>
        <p>{t.docs.overviewDesc}</p>
        <div class="overview-cards">
          <div class="overview-card overview-problem">
            <span class="overview-icon">⚠️</span>
            <p>{t.docs.overviewProblem}</p>
          </div>
          <div class="overview-card overview-solution">
            <span class="overview-icon">✅</span>
            <p>{t.docs.overviewSolution}</p>
          </div>
        </div>
      </section>

      <section id="requirements" class="docs-section">
        <h2>{t.docs.reqTitle}</h2>
        <ul class="docs-list">
          <li><strong>{t.docs.reqNode}</strong> - <a href="https://nodejs.org/" target="_blank" rel="noopener noreferrer">{t.docs.reqDownload}</a></li>
          <li><strong>{t.docs.reqAws}</strong> <em>({t.docs.reqAwsNote})</em> - <a href="https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html" target="_blank" rel="noopener noreferrer">{t.docs.reqInstallGuide}</a></li>
          <li><strong>{t.docs.reqAzure}</strong> <em>({t.docs.reqAzureNote})</em> - <a href="https://learn.microsoft.com/en-us/cli/azure/install-azure-cli" target="_blank" rel="noopener noreferrer">{t.docs.reqInstallGuide}</a></li>
        </ul>
      </section>

      <section id="installation" class="docs-section">
        <h2>{t.docs.installTitle}</h2>
        <div class="install-options">
          <div class="install-option">
            <span class="install-label">pnpm</span>
            <CodeBlock lang="bash" code="pnpm add -g envilder" />
          </div>
          <div class="install-option">
            <span class="install-label">npm</span>
            <CodeBlock lang="bash" code="npm install -g envilder" />
          </div>
          <div class="install-option">
            <span class="install-label">npx</span>
            <CodeBlock lang="bash" code="npx envilder --help" />
          </div>
        </div>
        <p>{t.docs.installNext}</p>
        <ul class="docs-list">
          <li><a href={localizedPath(lang, '/docs/cli/pull/')}>{t.docs.installNextPull}</a></li>
          <li><a href={localizedPath(lang, '/docs/cli/exec/')}>{t.docs.installNextExec}</a></li>
        </ul>
      </section>
    </>
  )}

  {routeKey === 'aws-ssm' && (
    <>
      <section id="aws-setup" class="docs-section">
        <h2>{t.docs.awsSetupTitle}</h2>
        <p>{t.docs.awsSetupIntro}</p>

        <h3>{t.docs.awsSetupCredTitle}</h3>
        <p>{t.docs.awsSetupCredDesc}</p>
        <CodeBlock lang="bash" code="aws configure" />
        <p>{t.docs.awsSetupCredProfile}</p>
        <CodeBlock lang="bash" code="aws configure --profile dev-account" />

        <h3>{t.docs.awsSetupPermTitle}</h3>
        <p>{t.docs.awsSetupPermDesc}</p>
        <table class="docs-table">
          <thead>
            <tr><th>{t.docs.awsSetupPermOperation}</th><th>{t.docs.awsSetupPermPermission}</th></tr>
          </thead>
          <tbody>
            <tr><td>{t.docs.awsSetupPermPull}</td><td><code>ssm:GetParameter</code></td></tr>
            <tr><td>{t.docs.awsSetupPermPush}</td><td><code>ssm:PutParameter</code></td></tr>
          </tbody>
        </table>
        <p>{t.docs.awsSetupPolicyExample}</p>
        <CodeBlock lang="json" code={`{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Action": ["ssm:GetParameter", "ssm:PutParameter"],
    "Resource": "arn:aws:ssm:us-east-1:123456789012:parameter/myapp/*"
  }]
}`} />

        <h3>{t.docs.awsSetupVerifyTitle}</h3>
        <p>{t.docs.awsSetupVerifyDesc}</p>
        <CodeBlock lang="bash" code={awsVerifyCmd} />
        <p class="note">{t.docs.awsSetupVerifySuccess}</p>
        <p>{t.docs.awsSetupVerifySdk}</p>
        <CodeBlock lang="python" code={`from envilder import Envilder

secrets = Envilder.load("test-map.json")
print(secrets["HELLO"])  # world`} />
      </section>
    </>
  )}

  {routeKey === 'azure-key-vault' && (
    <>
      <section id="azure-setup" class="docs-section">
        <h2>{t.docs.azureSetupTitle}</h2>
        <p>{t.docs.azureSetupIntro}</p>

        <h3>{t.docs.azureSetupCredTitle}</h3>
        <p>{t.docs.azureSetupCredDesc}</p>
        <CodeBlock lang="bash" code="az login" />
        <p>{t.docs.azureSetupCredVault}</p>

        <h3>{t.docs.azureSetupAccessTitle}</h3>
        <p>{t.docs.azureSetupCheck}</p>
        <CodeBlock lang="bash" code={azVaultShow} />
        <ul class="docs-list">
          <li><strong>{t.docs.azureRbacTrue}</strong></li>
          <li><strong>{t.docs.azureRbacFalse}</strong></li>
        </ul>

        <h4>{t.docs.azureOptionA}</h4>
        <CodeBlock lang="bash" code={azRbacAssign} />

        <h4>{t.docs.azureOptionB}</h4>
        <CodeBlock lang="bash" code={azVaultPolicy} />

        <h3>{t.docs.azureSetupPermTitle}</h3>
        <table class="docs-table">
          <thead>
            <tr><th>{t.docs.azureSetupPermOperation}</th><th>{t.docs.azureSetupPermPermission}</th></tr>
          </thead>
          <tbody>
            <tr><td>{t.docs.azureSetupPermPull}</td><td><strong>Get</strong></td></tr>
            <tr><td>{t.docs.azureSetupPermPush}</td><td><strong>Set</strong></td></tr>
          </tbody>
        </table>
        <p class="note">{t.docs.azureSetupPullNote}</p>

        <h3>{t.docs.azureSetupVerifyTitle}</h3>
        <p>{t.docs.azureSetupVerifyDesc}</p>
        <CodeBlock lang="bash" code={azureVerifyCmd} />
        <p class="note">{t.docs.azureSetupVerifySuccess}</p>
        <p>{t.docs.azureSetupVerifySdk}</p>
        <CodeBlock lang="python" code={`from envilder import Envilder

secrets = Envilder.load("test-map.json")
print(secrets["HELLO"])  # world`} />
      </section>
    </>
  )}

  {routeKey === 'map-file' && (
    <>
      <section id="mapping-file" class="docs-section">
        <h2>{t.docs.mapTitle}</h2>
        <p>{t.docs.mapIntro}</p>

        <div class="callout">
          <span class="callout-icon">📄</span>
          <div>
            <strong>{t.docs.mapCalloutStructure}</strong> {t.docs.mapCalloutKey}
            {t.docs.mapCalloutValue}
          </div>
        </div>

        <h3>{t.docs.mapBasicTitle}</h3>
        <p>{t.docs.mapBasicDesc}</p>
        <CodeBlock lang="json" filename="envilder.json" code={`{
  "API_KEY": "/myapp/prod/api-key",
  "DB_PASSWORD": "/myapp/prod/db-password",
  "SECRET_TOKEN": "/myapp/prod/secret-token"
}`} />
        <p>{t.docs.mapBasicGenerates}</p>
        <CodeBlock lang="dotenv" filename=".env" code={`API_KEY={value from /myapp/prod/api-key}
DB_PASSWORD={value from /myapp/prod/db-password}
SECRET_TOKEN={value from /myapp/prod/secret-token}`} />

        <h3>{t.docs.mapConfigTitle}</h3>
        <p>{t.docs.mapConfigDesc}</p>

        <h4>{t.docs.mapConfigOptionsTitle}</h4>
        <table class="docs-table">
          <thead>
            <tr><th>{t.docs.mapThKey}</th><th>{t.docs.mapThType}</th><th>{t.docs.mapThDefault}</th><th>{t.docs.mapThDescription}</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><code>provider</code></td>
              <td><code>"aws"</code> | <code>"azure"</code></td>
              <td><code>"aws"</code></td>
              <td>{t.docs.mapProviderDesc}</td>
            </tr>
            <tr>
              <td><code>vaultUrl</code></td>
              <td><code>string</code></td>
              <td>-</td>
              <td>{t.docs.mapVaultUrlDesc}</td>
            </tr>
            <tr>
              <td><code>profile</code></td>
              <td><code>string</code></td>
              <td>-</td>
              <td>{t.docs.mapProfileDesc}</td>
            </tr>
          </tbody>
        </table>

        <h3>{t.docs.mapAwsProfileTitle}</h3>
        <p>{t.docs.mapAwsProfileDesc}</p>
        <CodeBlock lang="json" filename="envilder.json" code={`{
  "$config": {
    "provider": "aws",
    "profile": "prod-account"
  },
  "API_KEY": "/myapp/prod/api-key",
  "DB_PASSWORD": "/myapp/prod/db-password"
}`} />
        <p>{t.docs.mapAwsProfileExplain}</p>

        <h3>{t.docs.mapAzureTitle}</h3>
        <p>{t.docs.mapAzureDesc}</p>
        <CodeBlock lang="json" filename="envilder.json" code={`{
  "$config": {
    "provider": "azure",
    "vaultUrl": "https://my-vault.vault.azure.net"
  },
  "API_KEY": "myapp-prod-api-key",
  "DB_PASSWORD": "myapp-prod-db-password"
}`} />

        <div class="callout callout-warning">
          <span class="callout-icon">⚠️</span>
          <div>
            <strong>{t.docs.mapAzureWarningTitle}</strong> {t.docs.mapAzureWarningDesc}
          </div>
        </div>

        <h3>{t.docs.mapDifferencesTitle}</h3>
        <table class="docs-table">
          <thead>
            <tr><th>{t.docs.mapThEmpty}</th><th>{t.docs.mapThAwsSsm}</th><th>{t.docs.mapThAzureKv}</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>{t.docs.mapSecretPathFormat}</strong></td>
              <td>{t.docs.mapAwsPathFormat}<br/><code>/myapp/prod/api-key</code></td>
              <td>{t.docs.mapAzurePathFormat}<br/><code>myapp-prod-api-key</code></td>
            </tr>
            <tr>
              <td><strong>{t.docs.mapRequiredConfig}</strong></td>
              <td>{t.docs.mapAwsRequiredConfig}</td>
              <td><code>{t.docs.mapAzureRequiredConfig}</code></td>
            </tr>
            <tr>
              <td><strong>{t.docs.mapOptionalConfig}</strong></td>
              <td><code>profile</code></td>
              <td>-</td>
            </tr>
            <tr>
              <td><strong>{t.docs.mapAuthentication}</strong></td>
              <td>{t.docs.mapAwsAuth}</td>
              <td>{t.docs.mapAzureAuth}</td>
            </tr>
          </tbody>
        </table>

        <h3>{t.docs.mapMultiEnvTitle}</h3>
        <p>{t.docs.mapMultiEnvDesc}</p>
        <div class="multi-env-grid">
          <CodeBlock lang="json" filename="config/dev/envilder.json" code={`{
  "$config": {
    "provider": "aws",
    "profile": "dev-account"
  },
  "API_KEY": "/myapp/dev/api-key",
  "DB_PASSWORD": "/myapp/dev/db-password"
}`} />
          <CodeBlock lang="json" filename="config/prod/envilder.json" code={`{
  "$config": {
    "provider": "aws",
    "profile": "prod-account"
  },
  "API_KEY": "/myapp/prod/api-key",
  "DB_PASSWORD": "/myapp/prod/db-password"
}`} />
        </div>
        <p>{t.docs.mapMultiEnvThenPull}</p>
        <CodeBlock lang="bash" code={`# Development
envilder --map=config/dev/envilder.json --envfile=.env.dev

# Production
envilder --map=config/prod/envilder.json --envfile=.env.prod`} />

        <h3>{t.docs.mapOverrideTitle}</h3>
        <p>{t.docs.mapOverrideDesc}</p>
        <CodeBlock lang="bash" code={`# Uses $config from the map file as-is
envilder

# Overrides provider and vault URL, ignoring $config
envilder --provider=azure \\
  --vault-url=https://other-vault.vault.azure.net \\
  --map=envilder.json --envfile=.env

# Overrides just the AWS profile
envilder --map=envilder.json --envfile=.env --profile=staging-account`} />

        <p class="note">{t.docs.mapPriorityNote}</p>
      </section>

      <section id="config-priority" class="docs-section">
        <h2>{t.docs.configPriorityTitle}</h2>
        <p>{t.docs.configPriorityDesc}</p>
        <div class="priority-stack">
          <div class="priority-item priority-1">1. {t.docs.configPriority1}</div>
          <div class="priority-item priority-2">2. {t.docs.configPriority2}</div>
          <div class="priority-item priority-3">3. {t.docs.configPriority3}</div>
        </div>
        <p>{t.docs.configPriorityExplain}</p>
      </section>
    </>
  )}

  {routeKey === 'cli-pull' && (
    <>
      <section id="pull-command" class="docs-section">
        <h2>{t.docs.pullTitle}</h2>
        <p>{t.docs.pullDesc}</p>

        <CodeBlock lang="bash" code="envilder" />

        <h3>{t.docs.pullOptions}</h3>
        <table class="docs-table">
          <thead>
            <tr><th>{t.docs.optionHeader}</th><th>{t.docs.mapThDescription}</th></tr>
          </thead>
          <tbody>
            <tr><td><code>--map</code></td><td>{t.docs.pullOptMap}</td></tr>
            <tr><td><code>--envfile</code></td><td>{t.docs.pullOptEnv}</td></tr>
            <tr><td><code>--provider</code></td><td>{t.docs.pullOptProvider}</td></tr>
            <tr><td><code>--vault-url</code></td><td>{t.docs.pullOptVault}</td></tr>
            <tr><td><code>--profile</code></td><td>{t.docs.pullOptProfile}</td></tr>
          </tbody>
        </table>

        <h3>{t.docs.pullExamples}</h3>
        <CodeBlock lang="bash" code={`${t.docs.pullCommentDefault}
envilder

${t.docs.pullCommentProfile}
envilder --map=envilder.json --envfile=.env --profile=prod-account

${t.docs.pullCommentAzureConfig}
envilder --map=envilder.azure.json --envfile=.env

${t.docs.pullCommentAzureFlags}
envilder --provider=azure \\
  --vault-url=https://my-vault.vault.azure.net \\
  --map=envilder.json --envfile=.env`} />

        <h3>{t.docs.pullOutputTitle}</h3>
        <CodeBlock lang="dotenv" filename=".env" code={`# Generated by Envilder
API_KEY=abc123
DB_PASSWORD=secret456`} />

        <div class="callout">
          <span class="callout-icon">💡</span>
          <div>
            <strong>{t.docs.pullExecTitle}</strong> {t.docs.pullExecDesc}{' '}
            <a href={localizedPath(lang, '/docs/cli/exec/')}>{t.docs.pullExecGuideLink}</a>
          </div>
        </div>
      </section>
    </>
  )}

  {routeKey === 'cli-push' && (
    <>
      <section id="push-command" class="docs-section">
        <h2>{t.docs.pushTitle}</h2>
        <p>{t.docs.pushDesc}</p>

        <CodeBlock lang="bash" code="envilder --push" />

        <h3>{t.docs.pushOptions}</h3>
        <table class="docs-table">
          <thead>
            <tr><th>{t.docs.optionHeader}</th><th>{t.docs.mapThDescription}</th></tr>
          </thead>
          <tbody>
            <tr><td><code>--push</code></td><td>{t.docs.pushOptPush}</td></tr>
            <tr><td><code>--envfile</code></td><td>{t.docs.pushOptEnv}</td></tr>
            <tr><td><code>--map</code></td><td>{t.docs.pushOptMap}</td></tr>
            <tr><td><code>--provider</code></td><td>{t.docs.pushOptProvider}</td></tr>
            <tr><td><code>--vault-url</code></td><td>{t.docs.pushOptVault}</td></tr>
            <tr><td><code>--profile</code></td><td>{t.docs.pushOptProfile}</td></tr>
          </tbody>
        </table>

        <h3>{t.docs.pushExamples}</h3>
        <CodeBlock lang="bash" code={`${t.docs.pushCommentAws}
envilder --push

${t.docs.pushCommentProfile}
envilder --push --envfile=.env.prod --map=envilder.json --profile=prod-account

${t.docs.pushCommentAzureConfig}
envilder --push --envfile=.env --map=envilder.azure.json

${t.docs.pushCommentAzureFlags}
envilder --push --provider=azure \\
  --vault-url=https://my-vault.vault.azure.net \\
  --envfile=.env --map=envilder.json`} />
      </section>

      <section id="push-single" class="docs-section">
        <h2>{t.docs.pushSingleTitle}</h2>
        <p>{t.docs.pushSingleDesc}</p>

        <CodeBlock lang="bash" code={pushSingleCmd} />

        <h3>{t.docs.pushSingleOptions}</h3>
        <table class="docs-table">
          <thead>
            <tr><th>{t.docs.optionHeader}</th><th>{t.docs.mapThDescription}</th></tr>
          </thead>
          <tbody>
            <tr><td><code>--push</code></td><td>{t.docs.pushSingleOptPush}</td></tr>
            <tr><td><code>--key</code></td><td>{t.docs.pushSingleOptKey}</td></tr>
            <tr><td><code>--value</code></td><td>{t.docs.pushSingleOptValue}</td></tr>
            <tr><td><code>--secret-path</code></td><td>{t.docs.pushSingleOptPath}</td></tr>
            <tr><td><code>--map</code></td><td>{t.docs.pushSingleOptMap}</td></tr>
            <tr><td><code>--provider</code></td><td>{t.docs.pushSingleOptProvider}</td></tr>
            <tr><td><code>--vault-url</code></td><td>{t.docs.pushSingleOptVault}</td></tr>
            <tr><td><code>--profile</code></td><td>{t.docs.pushSingleOptProfile}</td></tr>
          </tbody>
        </table>
      </section>
    </>
  )}

  {routeKey === 'cli-exec' && (
    <>
