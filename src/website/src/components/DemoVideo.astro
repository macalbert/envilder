---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section class="section section-alt" id="demo">
  <div class="container">
    <div class="section-title">
      <h2>{t.demo.title}<span>{t.demo.titleAccent}</span></h2>
      <p class="section-subtitle">
        {t.demo.subtitle}
      </p>
    </div>

    <figure class="demo-wrapper">
      <div class="demo-frame">
        <video
          data-src="/Envilder-demo.mp4"
          muted
          loop
          playsinline
          controls
          poster="/Envilder-demo-poster.webp"
          preload="none"
          aria-label={t.demo.cliDemo}
        />
      </div>
      <figcaption>{t.demo.transcript}</figcaption>
    </figure>
  </div>
</section>

<script>
  function initializeDemoVideo() {
    const video = document.querySelector<HTMLVideoElement>(
      '#demo .demo-frame video',
    );
    if (!video || !video.dataset.src) {
      return;
    }

    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    const loadVideo = () => {
      if (video.currentSrc) {
        return;
      }

      video.src = video.dataset.src ?? '';
      video.load();

      if (!reducedMotion) {
        video.addEventListener(
          'loadeddata',
          () => {
            void video.play().catch((error) => {
              console.warn('Envilder demo video could not play automatically.', error);
            });
          },
          { once: true },
        );
      }
    };
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          loadVideo();
          observer.disconnect();
        }
      },
      { rootMargin: '200px' },
    );

    observer.observe(video);
  }

  initializeDemoVideo();
  document.addEventListener('astro:after-swap', initializeDemoVideo);
</script>

<style>
  .demo-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .demo-wrapper figcaption {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
    margin-top: var(--space-md);
  }

  .demo-frame {
    border: 2px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--pixel-shadow);
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .demo-frame video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
