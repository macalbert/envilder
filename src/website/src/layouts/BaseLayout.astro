---
import {
  defaultLang,
  localizedLanguages,
  localizedPath,
  stripLocalePrefix,
  useTranslations,
} from '../i18n/utils';

export interface Props {
  title?: string;
  description?: string;
  lang?: string;
  noindex?: boolean;
}

const {
  title = 'Envilder: centralize your secrets. One command.',
  description = 'A CLI tool and GitHub Action that securely centralizes environment variables from AWS SSM Parameter Store or Azure Key Vault as a single source of truth.',
  lang = 'en',
  noindex = false,
} = Astro.props;

const skipLabel: Record<string, string> = {
  en: 'Skip to main content',
  es: 'Saltar al contenido principal',
  ca: 'Saltar al contingut principal',
};
const skipText = skipLabel[lang] ?? skipLabel.en;
const t = useTranslations(lang);
const openGraphLocale: Record<string, string> = {
  en: 'en_US',
  ca: 'ca_ES',
  es: 'es_ES',
};
const ogLocale = openGraphLocale[lang] ?? openGraphLocale.en;

const siteUrl = Astro.site ?? 'https://envilder.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const siteRootUrl = new URL('/', siteUrl).href;
const pathWithoutLocale = stripLocalePrefix(Astro.url.pathname);
const availableLanguages = localizedLanguages(pathWithoutLocale);
const defaultLanguageUrl = new URL(
  localizedPath(defaultLang, pathWithoutLocale),
  siteUrl,
).href;
const alternateLanguageUrls = availableLanguages.map((language) => ({
  language,
  href: new URL(localizedPath(language, pathWithoutLocale), siteUrl).href,
}));
const isHomePage = pathWithoutLocale === '/';
const ogImageUrl = new URL('/og-image.png', siteUrl).href;
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteRootUrl}#organization`,
      name: 'Envilder',
      url: siteRootUrl,
      sameAs: ['https://github.com/macalbert/envilder'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteRootUrl}#website`,
      name: 'Envilder',
      url: siteRootUrl,
      publisher: {
        '@id': `${siteRootUrl}#organization`,
      },
    },
    ...(!noindex
      ? [
          {
            '@type': 'WebPage',
            '@id': `${canonicalUrl}#webpage`,
            url: canonicalUrl,
            name: title,
            description,
            inLanguage: lang,
            isPartOf: {
              '@id': `${siteRootUrl}#website`,
            },
          },
        ]
      : []),
    ...(isHomePage && !noindex
      ? [
          {
            '@type': 'SoftwareApplication',
            '@id': `${siteRootUrl}#software`,
            name: 'Envilder',
            description,
            applicationCategory: 'DeveloperApplication',
            operatingSystem: 'Windows, macOS, Linux',
            isAccessibleForFree: true,
            codeRepository: 'https://github.com/macalbert/envilder',
            license: 'https://github.com/macalbert/envilder/blob/main/LICENSE',
            screenshot: ogImageUrl,
          },
        ]
      : []),
  ],
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Marçal Albert Castellví" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    {!noindex &&
      alternateLanguageUrls.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.language}
          href={alternate.href}
        />
      ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={defaultLanguageUrl} />}
    <script type="application/ld+json" set:html={structuredData}></script>

    <!-- OG -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Envilder" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.homeMeta.ogImageAlt} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />

    <!-- Theme: apply early to prevent FOUC -->
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('envilder-theme');
        if (stored && ['retro','light'].includes(stored)) {
          document.documentElement.setAttribute('data-theme', stored);
        } else {
          var preferLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          document.documentElement.setAttribute('data-theme', preferLight ? 'light' : 'retro');
        }
      })();
    </script>

    <!-- Smooth scroll: enable after initial hash scroll to prevent animated jump on refresh -->
    <script is:inline>
      (function() {
        if (!window.location.hash) {
          document.documentElement.classList.add('smooth-scroll');
        } else {
          window.addEventListener('load', function() {
            setTimeout(function() {
              document.documentElement.classList.add('smooth-scroll');
            }, 0);
          });
        }
      })();
    </script>

    <!-- Language: redirect to detected locale on first visit per session -->
    <script is:inline>
      (function() {
        // Only redirect once per browser session to avoid loops
        if (sessionStorage.getItem('envilder-lang-checked')) return;
        sessionStorage.setItem('envilder-lang-checked', '1');

        // Only redirect from default (English) paths
        var path = window.location.pathname;
        if (/^\/(es|ca)(\/?$|\/)/.test(path)) return;

        var lang = (navigator.language ||
          (navigator.languages && navigator.languages[0]) ||
          'en').toLowerCase();

        var locale = null;
        if (lang.startsWith('ca') || lang === 'val-es') locale = 'ca';
        else if (lang.startsWith('es')) locale = 'es';

        if (locale) {
          // Preserve sub-path, query, and hash
          var suffix = window.location.search + window.location.hash;
          var newPath = '/' + locale + (path === '/' ? '/' : path) + suffix;
          window.location.replace(newPath);
        }
      })();
    </script>

    <!-- Google Analytics (gtag.js) — only in production -->
    <script is:inline>
      (function() {
        if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') return;

        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-2SXP5HBC4M';
        document.head.appendChild(s);

        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', 'G-2SXP5HBC4M', { anonymize_ip: true });
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{skipText}</a>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
