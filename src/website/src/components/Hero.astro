---
import { useTranslations } from '../i18n/utils';
import TerminalMockup from './TerminalMockup.astro';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

type Seg = { text: string; cls: string; instant?: boolean };
type Editor = { file: string; lang: string; code: Seg[][] };
type Line = {
  kind: 'type' | 'output' | 'blank' | 'editor' | 'pause';
  segments?: Seg[];
  editor?: Editor;
  /** For `pause`: how long the running process stays quiet. */
  ms?: number;
};
type Scene = {
  id: string;
  name: string;
  desc: string;
  icon: string;
  /** Alt text for the tab icon when it tells scenes apart (e.g. provider). */
  iconAlt?: string;
  /** Row the tab sits in: CLI commands or runtime SDKs. */
  group: 'cli' | 'sdk';
  lines: Line[];
};

const jsonLines: Line[] = [
  { kind: 'output', segments: [{ text: '{', cls: 'output' }] },
  {
    kind: 'output',
    segments: [
      {
        text: '  "LOCALSTACK_AUTH_TOKEN": "/localstack/prod/auth-token"',
        cls: 'output',
      },
    ],
  },
  { kind: 'output', segments: [{ text: '}', cls: 'output' }] },
];

const cliRule = '━'.repeat(60);

const outputLine = (text: string, cls = 'output'): Line => ({
  kind: 'output',
  segments: [{ text, cls }],
});

// Mirrors EnvironmentVariable.maskSecretPath: keep the last 3 characters.
const maskPath = (path: string) => '*'.repeat(path.length - 3) + path.slice(-3);

const demoSecretValue = 'example-not-a-real-secret';

// A single-secret push on an empty directory: the secret goes to the vault
// and the map file `envilder exec` needs is written next to it.
const setupScene = (opts: {
  id: string;
  icon: string;
  provider: string;
  pushComment: string;
  /** Provider flags typed before the push options (empty for AWS). */
  providerFlags: Seg[];
  configLines: string[];
  secretPath: string;
  execSource: string;
}): Scene => ({
  id: opts.id,
  name: t.hero.tabPush,
  desc: t.hero.tabPushDesc,
  icon: opts.icon,
  iconAlt: opts.provider,
  group: 'cli',
  lines: [
    {
      kind: 'type',
      segments: [{ text: opts.pushComment, cls: 'comment' }],
    },
    {
      kind: 'type',
      segments: [
        { text: '❯', cls: 'prompt', instant: true },
        { text: ' ls -a', cls: 'command' },
      ],
    },
    outputLine('.  ..'),
    {
      kind: 'type',
      segments: [
        { text: '❯', cls: 'prompt', instant: true },
        { text: ' npx envilder', cls: 'command' },
        ...opts.providerFlags,
        { text: ' --key', cls: 'flag' },
        { text: '=LOCALSTACK_AUTH_TOKEN', cls: 'command' },
        { text: ' --value', cls: 'flag' },
        { text: `=${demoSecretValue}`, cls: 'command' },
        { text: ' --secret-path', cls: 'flag' },
        { text: `=${opts.secretPath}`, cls: 'command' },
      ],
    },
    { kind: 'blank' },
    outputLine('📤 PUSHING SECRET', 'highlight'),
    outputLine(cliRule, 'highlight'),
    {
      kind: 'output',
      segments: [
        { text: '  → ', cls: 'output' },
        { text: 'LOCALSTACK_AUTH_TOKEN', cls: 'command' },
        { text: ` → ${maskPath(opts.secretPath)}`, cls: 'output' },
      ],
    },
    { kind: 'blank' },
    {
      kind: 'output',
      segments: [
        { text: '⭐ SECRET PUSHED', cls: 'highlight' },
        { text: '  —  ', cls: 'output' },
        { text: 'LOCALSTACK_AUTH_TOKEN', cls: 'command' },
        {
          text: `=${maskPath(demoSecretValue)} → ${maskPath(opts.secretPath)}`,
          cls: 'output',
        },
      ],
    },
    {
      kind: 'output',
      segments: [
        { text: '✓ ', cls: 'flag' },
        { text: 'Created ', cls: 'output' },
        { text: 'envilder.json', cls: 'command' },
      ],
    },
    { kind: 'blank' },
    {
      kind: 'type',
      segments: [{ text: t.hero.setupComment2, cls: 'comment' }],
    },
    {
      kind: 'type',
      segments: [
        { text: '❯', cls: 'prompt', instant: true },
        { text: ' cat ', cls: 'command' },
        { text: 'envilder.json', cls: 'flag' },
      ],
    },
    outputLine('{'),
    ...opts.configLines.map((text) => outputLine(text)),
    outputLine(`  "LOCALSTACK_AUTH_TOKEN": "${opts.secretPath}"`),
    outputLine('}'),
    { kind: 'blank' },
    {
      kind: 'type',
      segments: [{ text: t.hero.execComment1, cls: 'comment' }],
    },
    {
      kind: 'type',
      segments: [
        { text: '❯', cls: 'prompt', instant: true },
        { text: ' npx envilder', cls: 'command' },
        { text: ' exec', cls: 'flag' },
        { text: ' --', cls: 'output' },
        { text: ' node app.mjs', cls: 'command' },
      ],
    },
    {
      kind: 'output',
      segments: [
        {
          text: `envilder: 1 secret resolved (${opts.execSource}) → `,
          cls: 'output',
        },
        { text: 'node …', cls: 'command' },
      ],
    },
  ],
});

// Syntax tokens for the in-terminal editor. Colours come from the editor's
// `data-lang`, so each stack gets its own palette.
const kw = (text: string): Seg => ({ text, cls: 'tok-kw' });
const ty = (text: string): Seg => ({ text, cls: 'tok-type' });
const fn = (text: string): Seg => ({ text, cls: 'tok-fn' });
const str = (text: string): Seg => ({ text, cls: 'tok-str' });
const p = (text: string): Seg => ({ text, cls: 'tok-plain' });
const indent = (text: string): Seg => ({
  text,
  cls: 'tok-plain',
  instant: true,
});

const sdkScene = (opts: {
  id: string;
  name: string;
  desc: string;
  icon: string;
  editor: Editor;
  run: [string, string];
  output: string;
}): Scene => ({
  id: opts.id,
  name: opts.name,
  desc: opts.desc,
  icon: opts.icon,
  group: 'sdk',
  lines: [
    {
      kind: 'type',
      segments: [{ text: t.hero.sdkCommentLoad, cls: 'comment' }],
    },
    {
      kind: 'type',
      segments: [
        { text: '❯', cls: 'prompt', instant: true },
        { text: ' vim ', cls: 'command' },
        { text: opts.editor.file, cls: 'flag' },
      ],
    },
    { kind: 'editor', editor: opts.editor },
    {
      kind: 'type',
      segments: [
        { text: '❯', cls: 'prompt', instant: true },
        { text: opts.run[0], cls: 'command' },
        { text: opts.run[1], cls: 'flag' },
      ],
    },
    {
      kind: 'output',
      segments: [{ text: opts.output, cls: 'output' }],
    },
  ],
});

const scenes: Scene[] = [
  {
    id: 'exec',
    name: t.hero.tabExec,
    desc: t.hero.tabExecDesc,
    icon: '/favicon.svg',
    group: 'cli',
    lines: [
      {
        kind: 'type',
        segments: [{ text: t.hero.execMapComment, cls: 'comment' }],
      },
      {
        kind: 'type',
        segments: [
          { text: '❯', cls: 'prompt', instant: true },
          { text: ' cat ', cls: 'command' },
          { text: 'envilder.json', cls: 'flag' },
        ],
      },
      ...jsonLines,
      { kind: 'blank' },
      {
        kind: 'type',
        segments: [{ text: t.hero.execComment1, cls: 'comment' }],
      },
      {
        kind: 'type',
        segments: [
          { text: '❯', cls: 'prompt', instant: true },
          { text: ' npx envilder', cls: 'command' },
          { text: ' exec', cls: 'flag' },
          { text: ' --', cls: 'output' },
          { text: ' docker run --rm', cls: 'command' },
          { text: ' --env', cls: 'flag' },
          { text: ' LOCALSTACK_AUTH_TOKEN', cls: 'command' },
          { text: ' localstack/localstack', cls: 'command' },
        ],
      },
      {
        kind: 'output',
        segments: [
          {
            text: 'envilder: 1 secret resolved (aws, profile=default) → ',
            cls: 'output',
          },
          { text: 'docker …', cls: 'command' },
        ],
      },
      { kind: 'pause', ms: 700 },
      { kind: 'blank' },
      outputLine('LocalStack version: 2026.10.0'),
      {
        kind: 'output',
        segments: [
          { text: '2026-10-16T23:21:04.821  ', cls: 'comment' },
          { text: 'INFO', cls: 'flag' },
          { text: ' --- [  MainThread] ', cls: 'output' },
          { text: 'l.licensing.licensingv2'.padEnd(26), cls: 'command' },
          {
            text: ' : Successfully requested and activated new license ',
            cls: 'output',
          },
          {
            text: '00000000-0000-0000-0000-000000000000:ultimate',
            cls: 'flag',
          },
          { text: ' 🔑✅', cls: 'output' },
        ],
      },
      outputLine('Ready.', 'highlight'),
      { kind: 'pause', ms: 1500 },
      { kind: 'blank' },
      {
        kind: 'type',
        segments: [{ text: t.hero.execComment2, cls: 'comment' }],
      },
      {
        kind: 'type',
        segments: [
          { text: '❯', cls: 'prompt', instant: true },
          { text: ' ls -a', cls: 'command' },
        ],
      },
      {
        kind: 'output',
        segments: [{ text: '.  ..  envilder.json', cls: 'output' }],
      },
    ],
  },
  {
    id: 'cli',
    name: t.hero.tabPull,
    desc: t.hero.tabPullDesc,
    icon: '/favicon.svg',
    group: 'cli',
    lines: [
      {
        kind: 'type',
        segments: [{ text: t.hero.terminalComment1, cls: 'comment' }],
      },
      {
        kind: 'type',
        segments: [
          { text: '❯', cls: 'prompt', instant: true },
          { text: ' ls -a', cls: 'command' },
        ],
      },
      {
        kind: 'output',
        segments: [{ text: '.  ..  envilder.json', cls: 'output' }],
      },
      {
        kind: 'type',
        segments: [
          { text: '❯', cls: 'prompt', instant: true },
          { text: ' cat ', cls: 'command' },
          { text: 'envilder.json', cls: 'flag' },
        ],
      },
      ...jsonLines,
      { kind: 'blank' },
      {
        kind: 'type',
        segments: [{ text: t.hero.terminalComment2, cls: 'comment' }],
      },
      {
        kind: 'type',
        segments: [
          { text: '❯', cls: 'prompt', instant: true },
          { text: ' npx envilder', cls: 'command' },
          { text: ' --map', cls: 'flag' },
          { text: '=envilder.json', cls: 'command' },
          { text: ' --envfile', cls: 'flag' },
          { text: '=.env', cls: 'command' },
        ],
      },
      { kind: 'blank' },
      {
        kind: 'output',
        segments: [{ text: '🪙  RESOLVING SECRETS', cls: 'highlight' }],
      },
      {
        kind: 'output',
        segments: [{ text: cliRule, cls: 'highlight' }],
      },
      {
        kind: 'output',
        segments: [
          { text: '  ✓ ', cls: 'flag' },
          { text: 'LOCALSTACK_AUTH_TOKEN'.padEnd(22), cls: 'command' },
          { text: '→ *******************secret', cls: 'output' },
        ],
      },
      { kind: 'blank' },
      {
        kind: 'output',
        segments: [
          { text: '⭐ LEVEL CLEARED', cls: 'highlight' },
          { text: '  -  1/1 secrets loaded · ', cls: 'output' },
          { text: '.env', cls: 'command' },
          { text: ' written', cls: 'output' },
        ],
      },
      { kind: 'blank' },
      {
        kind: 'type',
        segments: [
          { text: '❯', cls: 'prompt', instant: true },
          { text: ' ls -a', cls: 'command' },
        ],
      },
      {
        kind: 'output',
        segments: [{ text: '.  ..  .env  envilder.json', cls: 'output' }],
      },
      {
        kind: 'type',
        segments: [
          { text: '❯', cls: 'prompt', instant: true },
          { text: ' cat ', cls: 'command' },
          { text: '.env', cls: 'flag' },
        ],
      },
      {
        kind: 'output',
        segments: [
          { text: 'LOCALSTACK_AUTH_TOKEN', cls: 'command' },
          { text: '=example-not-a-real-secret', cls: 'output' },
        ],
      },
    ],
  },
  setupScene({
    id: 'setup-aws',
    icon: '/AWS.svg',
    provider: 'AWS',
    pushComment: t.hero.setupComment1,
    providerFlags: [],
    configLines: [],
    secretPath: '/localstack/prod/auth-token',
    execSource: 'aws, profile=default',
  }),
  setupScene({
    id: 'setup-azure',
    icon: '/Azure.svg',
    provider: 'Azure',
    pushComment: t.hero.setupAzureComment1,
    providerFlags: [
      { text: ' --provider', cls: 'flag' },
      { text: '=azure', cls: 'command' },
      { text: ' --vault-url', cls: 'flag' },
      { text: '=https://my-vault.vault.azure.net', cls: 'command' },
    ],
    configLines: [
      '  "$config": {',
      '    "provider": "azure",',
      '    "vaultUrl": "https://my-vault.vault.azure.net"',
      '  },',
    ],
    secretPath: 'localstack-prod-auth-token',
    execSource: 'azure, vault=my-vault.vault.azure.net',
  }),
  sdkScene({
    id: 'nodejs',
    name: t.hero.tabNode,
    desc: t.hero.tabNodeDesc,
    icon: '/sdk-logo.svg',
    editor: {
      file: 'config.ts',
      lang: 'typescript',
      code: [
        [
          kw('import'),
          p(' { '),
          ty('Envilder'),
          p(' } '),
          kw('from'),
          p(' '),
          str("'@envilder/sdk'"),
          p(';'),
        ],
        [],
        [
          kw('const'),
          p(' secrets = '),
          kw('await'),
          p(' '),
          ty('Envilder'),
          p('.'),
          fn('load'),
          p('('),
          str("'envilder.json'"),
          p(');'),
        ],
        [p('console.'), fn('log'), p('(secrets);')],
      ],
    },
    run: [' node ', 'config.ts'],
    output: "Map(1) { 'LOCALSTACK_AUTH_TOKEN' => 'example-not-a-real-secret' }",
  }),
  sdkScene({
    id: 'python',
    name: t.hero.tabPython,
    desc: t.hero.tabPythonDesc,
    icon: '/sdk-python.svg',
    editor: {
      file: 'settings.py',
      lang: 'python',
      code: [
        [kw('from'), p(' envilder '), kw('import'), p(' '), ty('Envilder')],
        [],
        [
          p('secrets = '),
          ty('Envilder'),
          p('.'),
          fn('load'),
          p('('),
          str('"envilder.json"'),
          p(')'),
        ],
        [fn('print'), p('(secrets)')],
      ],
    },
    run: [' python ', 'settings.py'],
    output: "{'LOCALSTACK_AUTH_TOKEN': 'example-not-a-real-secret'}",
  }),
  sdkScene({
    id: 'dotnet',
    name: t.hero.tabDotnet,
    desc: t.hero.tabDotnetDesc,
    icon: '/sdk-dotnet.svg',
    editor: {
      file: 'Program.cs',
      lang: 'cs',
      code: [
        [kw('using'), p(' '), ty('Envilder'), p(';')],
        [],
        [
          kw('var'),
          p(' secrets = '),
          kw('await'),
          p(' '),
          ty('Env'),
          p('.'),
          fn('LoadAsync'),
          p('('),
          str('"envilder.json"'),
          p(');'),
        ],
        [
          kw('foreach'),
          p(' ('),
          kw('var'),
          p(' (key, value) '),
          kw('in'),
          p(' secrets)'),
        ],
        [p('{')],
        [
          indent('    '),
          ty('Console'),
          p('.'),
          fn('WriteLine'),
          p('('),
          str('$"{key} = {value}"'),
          p(');'),
        ],
        [p('}')],
      ],
    },
    run: [' dotnet ', 'run'],
    output: 'LOCALSTACK_AUTH_TOKEN = example-not-a-real-secret',
  }),
];

// Escape `<` so the serialized scenes can never break out of the
// <script type="application/json"> tag (e.g. a stray "</script>").
const scenesJson = JSON.stringify(scenes).replace(/</g, '\\u003c');

// Tab rows in scene order: the client script pairs the Nth tab with the Nth
// scene, so every CLI scene must come before the SDK scenes.
const tabRows = [
  {
    label: t.hero.tabGroupCli,
    scenes: scenes.filter((s) => s.group === 'cli'),
  },
  {
    label: t.hero.tabGroupSdk,
    scenes: scenes.filter((s) => s.group === 'sdk'),
  },
];
---

<section class="hero scanlines" id="hero">
  <div class="container hero-container">
    <div class="hero-content">
      <h1 class="hero-title">
        {t.hero.title1}<br />
        {t.hero.title2}<br />
        <span class="hero-accent">{t.hero.titleAccent}</span>
      </h1>

      <p class="hero-description">
        {t.hero.description}
      </p>
      <p class="hero-positioning">{t.hero.positioning}</p>

      <div class="hero-tech-line">
        <strong>{t.hero.descAws}</strong> {t.hero.descOr} <strong>{t.hero.descAzure}</strong>{t.hero.descSuffix}
      </div>

      <div class="hero-actions">
        <a
          href="#get-started"
          class="btn btn-primary"
          data-analytics-event="click_get_started"
        >
          {t.hero.getStarted}
        </a>
        <a
          href="https://github.com/macalbert/envilder"
          class="btn btn-outline"
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="click_github"
          data-analytics-placement="hero"
        >
          {t.hero.viewOnGithub}
        </a>
      </div>

      <div class="hero-install">
        <code class="install-cmd">
          <span class="prompt">❯</span> npm install -g envilder
        </code>
      </div>
    </div>

    <div class="hero-terminal">
      <button
        type="button"
        class="hero-term-pause"
        data-hero-pause
        data-label-pause={t.hero.terminalPause}
        data-label-play={t.hero.terminalPlay}
        aria-label={t.hero.terminalPause}
        aria-pressed="false"
        hidden
      >
        <svg class="icon-pause" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
          <path d="M2 1h3v10H2z M7 1h3v10H7z"/>
        </svg>
        <svg class="icon-play" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
          <path d="M2 1h2v1h2v1h2v2h2v2H8v2H6v1H4v1H2z"/>
        </svg>
      </button>
      <TerminalMockup title="envilder" icon>
        <div class="hero-term-screen" data-hero-screen aria-live="off">
          {scenes[0].lines.map((line) =>
            line.kind === 'blank' ? (
              <span class="line">&nbsp;</span>
            ) : (
              <span class="line">
                {line.segments?.map((seg) => (
                  <span class={seg.cls}>{seg.text}</span>
                ))}
              </span>
            ),
          )}
          <span class="line"><span class="prompt">❯</span><span class="cursor"></span></span>
        </div>
      </TerminalMockup>

      <script
        type="application/json"
        id="hero-term-data"
        set:html={scenesJson}
      />

      <div
        class="hero-term-modes"
        role="group"
        aria-label={t.hero.terminalSceneLabel}
      >
        {tabRows.map((row) => (
          <div class="hero-term-row" role="group" aria-label={row.label}>
            <span class="hero-term-row-label" aria-hidden="true">
              {row.label}
            </span>
            <div class="hero-term-row-tabs">
              {row.scenes.map((scene) => {
                const first = scene.id === scenes[0].id;
                return (
                  <button
                    class:list={['hero-term-mode', { active: first }]}
                    aria-pressed={first ? 'true' : 'false'}
                    data-hero-mode={scene.id}
                    title={scene.desc}
                    type="button"
                  >
                    <img
                      src={scene.icon}
                      alt={scene.iconAlt ?? ''}
                      class="hero-term-mode-icon"
                      width="18"
                      height="18"
                    />
                    <span class="hero-term-mode-name">{scene.name}</span>
                  </button>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="hero-gradient"></div>
</section>

<style>
  .hero {
    padding-top: calc(var(--nav-height) + var(--space-4xl));
    padding-bottom: var(--space-4xl);
    position: relative;
    overflow: hidden;
  }

  .hero-gradient {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 600px;
    background: radial-gradient(
      ellipse at center,
      rgba(138, 154, 108, 0.08) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3xl);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .hero-title {
    font-size: clamp(2.2rem, 6vw, 4rem);
    line-height: 1.05;
  }

  .hero-accent {
    color: var(--color-primary);
  }

  .hero-description {
    font-size: 1.1rem;
    line-height: 1.8;
    max-width: 520px;
  }

  .hero-description strong {
    color: var(--color-secondary);
  }

  .hero-positioning {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    max-width: 560px;
  }

  .hero-tech-line {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }

  .hero-tech-line strong {
    color: var(--color-secondary);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .hero-install {
    margin-top: var(--space-sm);
  }

  .install-cmd {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    background: var(--color-code-bg);
    border: 1px solid var(--color-border);
    padding: var(--space-sm) var(--space-md);
    display: inline-block;
  }

  .install-cmd .prompt {
    color: var(--color-prompt);
    font-weight: 700;
  }

  .hero-terminal {
    position: relative;
    width: 100%;
  }

  /* Pause/play for the autoplaying demo, overlaid on the terminal title bar */
  .hero-term-pause {
    position: absolute;
    top: 3px;
    right: var(--space-sm);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 24px;
    background: none;
    border: none;
    color: var(--term-muted);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .hero-term-pause:hover {
    color: var(--term-text);
  }

  .hero-term-pause[hidden] {
    display: none;
  }

  .hero-term-pause .icon-play,
  .hero-term-pause[aria-pressed='true'] .icon-pause {
    display: none;
  }

  .hero-term-pause[aria-pressed='true'] .icon-play {
    display: block;
  }

  .hero-term-screen {
    display: block;
    height: 21em;
    overflow: hidden;
  }

  /* Reduced motion renders whole transcripts at once; let readers scroll
     back to the start with a pointer or the keyboard. */
  .hero-term-screen.is-static {
    overflow-y: auto;
  }

  .hero-term-screen :global(.line) {
    display: block;
    min-height: 1.8em;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* One row per surface (CLI commands, runtime SDKs). The label column has a
     fixed width so both rows of tabs start at the same edge, and each row's
     tabs share the remaining width. */
  .hero-term-modes {
    display: grid;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .hero-term-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-sm);
  }

  .hero-term-row-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .hero-term-row-tabs {
    display: grid;
    /* auto-fit keeps each row on one line while the tabs fit, and wraps them
       when they cannot (narrow screens, 200% text zoom). */
    grid-template-columns: repeat(auto-fit, minmax(4rem, 1fr));
    gap: var(--space-sm);
  }

  /* Four CLI tabs only fit a 375px screen with tighter side padding. */
  @media (max-width: 479px) {
    .hero-term-row-tabs .hero-term-mode {
      padding-inline: var(--space-xs);
    }
  }

  .hero-term-mode {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    min-width: 0;
    padding: var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .hero-term-mode:hover {
    color: var(--color-text);
    background: var(--color-surface-alt);
    border-color: var(--color-border-light, var(--color-border));
  }

  .hero-term-mode.active {
    color: var(--color-text);
    border-color: var(--color-primary);
    background: var(--color-surface-alt);
  }

  .hero-term-mode-icon {
    width: 18px;
    height: 18px;
    object-fit: contain;
    flex-shrink: 0;
    opacity: 0.5;
    transition: opacity 0.2s;
  }

  .hero-term-mode.active .hero-term-mode-icon {
    opacity: 1;
  }

  .hero-term-mode-name {
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* In-terminal editor for the SDK scenes. Each stack sets its own accent
     and syntax palette through data-lang. */
  .hero-term-screen :global(.vim) {
    --vim-accent: var(--term-highlight);
    --vim-accent-text: var(--term-header);
    --tok-kw: var(--term-highlight);
    --tok-type: var(--term-path);
    --tok-fn: var(--term-yellow);
    --tok-str: var(--term-flag);
    display: flex;
    flex-direction: column;
    height: 100%;
    white-space: pre;
  }

  .hero-term-screen :global(.vim[data-lang='typescript']) {
    --vim-accent: #3178c6;
    --vim-accent-text: #ffffff;
    --vim-accent-label: #5a9be8;
    --tok-kw: #569cd6;
    --tok-type: #4ec9b0;
    --tok-fn: #dcdcaa;
    --tok-str: #ce9178;
  }

  .hero-term-screen :global(.vim[data-lang='python']) {
    --vim-accent: #ffd43b;
    --vim-accent-text: #1e1e2e;
    --tok-kw: #ffd43b;
    --tok-type: #7aa7e0;
    --tok-fn: #8ec07c;
    --tok-str: #e5a46b;
  }

  .hero-term-screen :global(.vim[data-lang='cs']) {
    --vim-accent: #7c4dff;
    --vim-accent-text: #ffffff;
    --vim-accent-label: #a78bfa;
    --tok-kw: #a78bfa;
    --tok-type: #4ec9b0;
    --tok-fn: #dcdcaa;
    --tok-str: #d69d85;
  }

  .hero-term-screen :global(.vim.is-static) {
    height: auto;
    margin-bottom: var(--space-sm);
  }

  .hero-term-screen :global(.vim-buffer) {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .hero-term-screen :global(.vim-line) {
    display: flex;
    min-height: 1.8em;
  }

  /* Long lines wrap past the gutter (like vim's breakindent) so narrow
     screens never clip the code or the cursor. */
  .hero-term-screen :global(.vim-code) {
    flex: 1;
    min-width: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .hero-term-screen :global(.vim-tilde) {
    display: block;
    min-height: 1.8em;
  }

  .hero-term-screen :global(.vim-num) {
    flex-shrink: 0;
    width: 3ch;
    margin-right: 1.5ch;
    text-align: right;
    color: var(--term-dim);
  }

  .hero-term-screen :global(.vim-tilde) {
    color: var(--term-border);
  }

  .hero-term-screen :global(.vim.is-static .vim-tildes) {
    display: none;
  }

  .hero-term-screen :global(.tok-kw) { color: var(--tok-kw); }
  .hero-term-screen :global(.tok-type) { color: var(--tok-type); }
  .hero-term-screen :global(.tok-fn) { color: var(--tok-fn); }
  .hero-term-screen :global(.tok-str) { color: var(--tok-str); }
  .hero-term-screen :global(.tok-plain) { color: var(--term-text); }

  .hero-term-screen :global(.vim-status) {
    display: flex;
    background: var(--term-header);
    color: var(--term-muted);
    font-size: 0.75rem;
    line-height: 1.8;
  }

  .hero-term-screen :global(.vim-mode),
  .hero-term-screen :global(.vim-pos) {
    padding: 0 1ch;
    background: var(--vim-accent);
    color: var(--vim-accent-text);
    font-weight: 700;
  }

  .hero-term-screen :global(.vim-file),
  .hero-term-screen :global(.vim-lang) {
    padding: 0 1ch;
  }

  /* Lighter shade where the accent alone is under 4.5:1 on the bar. */
  .hero-term-screen :global(.vim-lang) {
    color: var(--vim-accent-label, var(--vim-accent));
  }

  .hero-term-screen :global(.vim-spacer) {
    flex: 1;
  }

  .hero-term-screen :global(.vim-cmd) {
    min-height: 1.8em;
    color: var(--term-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-term-screen :global(.cursor) {
      animation: none;
    }
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  type Seg = { text: string; cls: string; instant?: boolean };
  type Editor = { file: string; lang: string; code: Seg[][] };
  type Line = {
    kind: 'type' | 'output' | 'blank' | 'editor' | 'pause';
    segments?: Seg[];
    editor?: Editor;
    ms?: number;
  };
  type Scene = { id: string; name: string; desc: string; lines: Line[] };

  function initHeroTerminal() {
    const wrapper = document.querySelector<HTMLElement>('.hero-terminal');
    if (!wrapper || wrapper.dataset.heroTermInit) return;

    const screen = wrapper.querySelector<HTMLElement>('[data-hero-screen]');
    const dataEl = wrapper.querySelector<HTMLElement>('#hero-term-data');
    const modes = Array.from(
      wrapper.querySelectorAll<HTMLButtonElement>('.hero-term-mode'),
    );
    if (!screen || !dataEl || modes.length === 0) return;

    let scenes: Scene[];
    try {
      scenes = JSON.parse(dataEl.textContent || '[]') as Scene[];
    } catch {
      return;
    }
    if (scenes.length === 0) return;

    wrapper.dataset.heroTermInit = 'true';

    // Each init claims a global generation token. Any previously running
    // playback loop (e.g. left over from an Astro view transition) sees a
    // newer generation and bails out, so only one loop ever drives the screen.
    const globalState = window as unknown as { __heroTermGen?: number };
    const generation = (globalState.__heroTermGen ?? 0) + 1;
    globalState.__heroTermGen = generation;
    const isStale = () => generation !== globalState.__heroTermGen;

    // Astro client-side navigation may swap to a page without this script, so
    // no new init runs to claim a fresh generation. Bumping the token on
    // `astro:after-swap` makes any pending scheduleNext() autoplay go stale
    // immediately, preventing timers from firing against a detached DOM.
    document.addEventListener(
      'astro:after-swap',
      () => {
        globalState.__heroTermGen = (globalState.__heroTermGen ?? 0) + 1;
      },
      { once: true },
    );

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    let runId = 0;
    let current = 0;
    let paused = false;
    // Hover/focus pauses temporarily; the pause button pauses until the
    // user resumes it (touch users have no hover to stop the loop).
    let hovering = false;
    let userPaused = false;
    // True while a manually selected scene is shown statically during an
    // explicit pause, so Resume knows to replay it.
    let showingStatic = false;
    let holdTimer: ReturnType<typeof setTimeout> | undefined;
    let scrollFrame: number | undefined;

    const sleep = (ms: number) =>
      new Promise<void>((resolve) => setTimeout(resolve, ms));

    function waitWhilePaused(): Promise<void> {
      if (!paused || isStale()) return Promise.resolve();
      return new Promise<void>((resolve) => {
        const check = () => {
          if (paused && !isStale()) {
            setTimeout(check, 120);
          } else {
            resolve();
          }
        };
        check();
      });
    }

    // Playback timing (ms). Every scene shares these so the rhythm stays
    // consistent; the jitter makes the typing read as a person at a keyboard.
    const TIMING = {
      sceneHold: 3000,
      thinkAfterPrompt: [250, 450],
      enterAfterCommand: [450, 700],
      enterAfterComment: [250, 400],
      outputSettle: [300, 450],
      blankLine: 120,
      editorOpen: 600,
      editorNewline: [120, 220],
      editorModeSwitch: [300, 450],
    } as const;

    const between = ([min, max]: readonly [number, number]) =>
      min + Math.random() * (max - min);

    // Roughly bell-shaped around 40ms per key, slower at word boundaries and
    // punctuation, with an occasional short hesitation mid-word.
    function keyDelay(ch: string): number {
      const base = 28 + (Math.random() + Math.random()) * 12;
      if (ch === ' ') return base + between([40, 100]);
      if (/[=\-/.,:'"(){}]/.test(ch)) return base + between([15, 45]);
      if (Math.random() < 0.03) return base + between([120, 260]);
      return base;
    }

    function setActiveMode(index: number) {
      modes.forEach((m, i) => {
        const active = i === index;
        m.classList.toggle('active', active);
        m.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    // Keeps the line being typed in view when wrapped code outgrows the
    // editor buffer (narrow screens).
    function followEditorCursor(): void {
      const buffer = screen!.querySelector<HTMLElement>('.vim-buffer');
      const lines = buffer?.querySelectorAll<HTMLElement>('.vim-line');
      if (!buffer || !lines?.length) return;
      const last = lines[lines.length - 1];
      const top = last.offsetTop + last.offsetHeight - buffer.clientHeight;
      if (top > buffer.scrollTop) buffer.scrollTop = top;
    }

    function keepLatestLineVisible(): void {
      followEditorCursor();
      if (scrollFrame !== undefined) return;
      scrollFrame = window.requestAnimationFrame(() => {
        const top = screen!.scrollHeight - screen!.clientHeight;
        if (top > screen!.scrollTop) {
          screen!.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
        }
        scrollFrame = undefined;
      });
    }

    function makeLineEl(): HTMLElement {
      const el = document.createElement('span');
      el.className = 'line';
      screen!.appendChild(el);
      keepLatestLineVisible();
      return el;
    }

    // Holds while paused, then reports whether this run is still current.
    // Gate every delayed DOM update on this so a pause freezes the frame.
    async function settle(id: number): Promise<boolean> {
      await waitWhilePaused();
      return alive(id);
    }

    function renderInstant(scene: Scene) {
      screen!.classList.add('is-static');
      screen!.tabIndex = 0;
      screen!.innerHTML = '';
      for (const line of scene.lines) {
        if (line.kind === 'editor') {
          screen!.appendChild(renderEditorStatic(line.editor!));
          continue;
        }
        if (line.kind === 'pause') continue;
        const el = makeLineEl();
        if (line.kind === 'blank') {
          el.innerHTML = '&nbsp;';
          continue;
        }
        for (const seg of line.segments || []) {
          const span = document.createElement('span');
          span.className = seg.cls;
          span.textContent = seg.text;
          el.appendChild(span);
        }
      }
      const prompt = makeLineEl();
      prompt.innerHTML =
        '<span class="prompt">❯</span><span class="cursor"></span>';
      keepLatestLineVisible();
    }

    function scheduleNext(index: number) {
      if (reduceMotion) return;
      holdTimer = setTimeout(() => {
        play((index + 1) % scenes.length);
      }, TIMING.sceneHold);
    }

    // A playback is "alive" while it owns the current run id and no newer
    // generation has superseded it. Centralising the guard keeps every loop
    // body simple (complexity 1 instead of repeated `||` checks).
    function alive(id: number): boolean {
      return id === runId && !isStale();
    }

    function appendSeg(el: HTMLElement, seg: Seg, before?: Node): HTMLElement {
      const span = document.createElement('span');
      span.className = seg.cls;
      if (before) {
        el.insertBefore(span, before);
      } else {
        el.appendChild(span);
      }
      return span;
    }

    // Prints consecutive output lines in one shot and returns the next index.
    function dumpOutputRun(lines: Line[], start: number): number {
      let i = start;
      while (i < lines.length && lines[i].kind === 'output') {
        const el = makeLineEl();
        for (const seg of lines[i].segments ?? []) {
          appendSeg(el, seg).textContent = seg.text;
        }
        i += 1;
      }
      return i;
    }

    async function typeSegment(
      el: HTMLElement,
      seg: Seg,
      cursor: HTMLElement,
      id: number,
    ): Promise<boolean> {
      const span = appendSeg(el, seg, cursor);
      if (seg.instant) {
        span.textContent = seg.text;
        keepLatestLineVisible();
        // The prompt appears at once; give the "user" a beat before typing.
        if (seg.cls === 'prompt') await sleep(between(TIMING.thinkAfterPrompt));
        return true;
      }
      for (const ch of seg.text) {
        await waitWhilePaused();
        if (!alive(id)) return false;
        span.textContent += ch;
        keepLatestLineVisible();
        await sleep(keyDelay(ch));
      }
      return true;
    }

    async function typeCommandLine(
      line: Line,
      cursor: HTMLElement,
      id: number,
    ): Promise<boolean> {
      const el = makeLineEl();
      el.appendChild(cursor);
      for (const seg of line.segments ?? []) {
        if (!(await typeSegment(el, seg, cursor, id))) return false;
      }
      // Mini pause for pressing Enter; a command also "runs" for a moment.
      const isCommand = line.segments?.[0]?.instant === true;
      await sleep(
        between(
          isCommand ? TIMING.enterAfterCommand : TIMING.enterAfterComment,
        ),
      );
      return true;
    }

    function appendBlankLine(): void {
      makeLineEl().innerHTML = '&nbsp;';
    }

    function appendPromptLine(cursor: HTMLElement): void {
      const prompt = makeLineEl();
      const dollar = document.createElement('span');
      dollar.className = 'prompt';
      dollar.textContent = '❯';
      prompt.appendChild(dollar);
      prompt.appendChild(cursor);
    }

    type EditorView = {
      root: HTMLElement;
      buffer: HTMLElement;
      tildes: HTMLElement;
      mode: HTMLElement;
      pos: HTMLElement;
      cmd: HTMLElement;
    };

    function mk(tag: string, cls: string, text = ''): HTMLElement {
      const node = document.createElement(tag);
      node.className = cls;
      node.textContent = text;
      return node;
    }

    // A vim-like editor: numbered buffer, `~` filler, status line, cmdline.
    function buildEditor(editor: Editor): EditorView {
      const root = mk('div', 'vim');
      root.dataset.lang = editor.lang;
      const buffer = mk('div', 'vim-buffer');
      const tildes = mk('div', 'vim-tildes');
      for (let i = 0; i < 20; i++) tildes.appendChild(mk('span', 'vim-tilde', '~'));
      buffer.appendChild(tildes);
      const status = mk('div', 'vim-status');
      const mode = mk('span', 'vim-mode', 'NORMAL');
      const pos = mk('span', 'vim-pos', '1:1');
      status.append(
        mode,
        mk('span', 'vim-file', editor.file),
        mk('span', 'vim-spacer'),
        mk('span', 'vim-lang', editor.lang),
        pos,
      );
      const cmd = mk('div', 'vim-cmd');
      root.append(buffer, status, cmd);
      return { root, buffer, tildes, mode, pos, cmd };
    }

    // Adds buffer line `n` and returns the element that holds its code.
    function addEditorLine(view: EditorView, n: number): HTMLElement {
      const line = mk('div', 'vim-line');
      const code = mk('span', 'vim-code');
      line.append(mk('span', 'vim-num', String(n)), code);
      view.buffer.insertBefore(line, view.tildes);
      return code;
    }

    function setEditorMode(view: EditorView, insert: boolean): void {
      view.mode.textContent = insert ? 'INSERT' : 'NORMAL';
      view.root.classList.toggle('is-insert', insert);
      view.cmd.textContent = insert ? '-- INSERT --' : '';
    }

    function renderEditorStatic(editor: Editor): HTMLElement {
      const view = buildEditor(editor);
      view.root.classList.add('is-static');
      editor.code.forEach((row, r) => {
        const code = addEditorLine(view, r + 1);
        for (const seg of row) appendSeg(code, seg).textContent = seg.text;
      });
      return view.root;
    }

    // Opens the editor full screen (like vim's alternate screen), types the
    // file in INSERT mode, saves with `:wq` and restores the shell.
    async function playEditor(
      editor: Editor,
      cursor: HTMLElement,
      id: number,
    ): Promise<boolean> {
      const shell = Array.from(screen!.childNodes);
      const view = buildEditor(editor);
      screen!.replaceChildren(view.root);
      screen!.scrollTop = 0;

      let code = addEditorLine(view, 1);
      code.appendChild(cursor);
      view.cmd.textContent = `"${editor.file}" [New]`;
      await sleep(TIMING.editorOpen);
      if (!(await settle(id))) return false;

      setEditorMode(view, true);
      await sleep(between(TIMING.editorModeSwitch));
      if (!(await settle(id))) return false;

      for (const [r, row] of editor.code.entries()) {
        if (r > 0) {
          await sleep(between(TIMING.editorNewline));
          if (!(await settle(id))) return false;
          code = addEditorLine(view, r + 1);
          code.appendChild(cursor);
        }
        view.pos.textContent = `${r + 1}:1`;
        for (const seg of row) {
          if (!(await typeSegment(code, seg, cursor, id))) return false;
        }
        view.pos.textContent = `${r + 1}:${code.textContent!.length + 1}`;
      }

      await sleep(between(TIMING.editorModeSwitch));
      if (!(await settle(id))) return false;
      setEditorMode(view, false);
      await sleep(between(TIMING.editorModeSwitch));
      if (!(await settle(id))) return false;

      view.cmd.appendChild(cursor);
      const save = { text: ':wq', cls: 'tok-plain' };
      if (!(await typeSegment(view.cmd, save, cursor, id))) return false;
      await sleep(between(TIMING.enterAfterCommand));
      if (!(await settle(id))) return false;

      screen!.replaceChildren(...shell);
      keepLatestLineVisible();
      return true;
    }

    // Renders a single line and returns the next index, or -1 if a newer
    // run superseded this one.
    async function playLine(
      lines: Line[],
      i: number,
      cursor: HTMLElement,
      id: number,
    ): Promise<number> {
      const line = lines[i];

      if (line.kind === 'output') {
        const next = dumpOutputRun(lines, i);
        // Let the output land before the next keystroke.
        await sleep(between(TIMING.outputSettle));
        return next;
      }

      if (line.kind === 'blank') {
        appendBlankLine();
        await sleep(TIMING.blankLine);
        return i + 1;
      }

      if (line.kind === 'editor') {
        if (!(await playEditor(line.editor!, cursor, id))) return -1;
        return i + 1;
      }

      if (line.kind === 'pause') {
        // Sleep in short steps so a hover pause or a newer run takes effect
        // mid-pause instead of after it.
        let left = line.ms ?? 0;
        while (left > 0) {
          await waitWhilePaused();
          if (!alive(id)) return -1;
          const step = Math.min(left, 100);
          await sleep(step);
          left -= step;
        }
        return i + 1;
      }

      if (!(await typeCommandLine(line, cursor, id))) return -1;
      return i + 1;
    }

    // Plays one scene to completion. Returns false if a newer run took over.
    async function playScene(
      scene: Scene,
      cursor: HTMLElement,
      id: number,
    ): Promise<boolean> {
      const lines = scene.lines;
      let i = 0;
      while (i < lines.length) {
        await waitWhilePaused();
        if (!alive(id)) return false;
        i = await playLine(lines, i, cursor, id);
        if (i < 0) return false;
      }
      return true;
    }

    async function play(index: number, manual = false) {
      if (isStale()) return;
      const id = ++runId;
      if (holdTimer) clearTimeout(holdTimer);

      // Auto-rotation waits out any pause before switching the active
      // button, so the selection never runs ahead of the screen.
      if (!manual && !reduceMotion && !(await settle(id))) return;

      current = index;
      setActiveMode(index);

      const scene = scenes[index];
      if (reduceMotion) {
        renderInstant(scene);
        return;
      }

      // An explicit pause shows the chosen scene at once instead of leaving
      // the previous one on screen until Resume.
      if (manual && userPaused) {
        showingStatic = true;
        renderInstant(scene);
        return;
      }
      if (showingStatic) {
        showingStatic = false;
        screen!.classList.remove('is-static');
        screen!.removeAttribute('tabindex');
      }

      // Wait for any pause to lift before clearing the screen, so an
      // auto-rotation that fires while the user is hovering does not blank
      // the terminal until they unpause.
      await waitWhilePaused();
      if (!alive(id)) return;

      screen!.innerHTML = '';
      screen!.scrollTop = 0;
      const cursor = document.createElement('span');
      cursor.className = 'cursor';

      if (await playScene(scene, cursor, id)) {
        // A pause during the last line also holds the closing prompt
        if (!(await settle(id))) return;
        appendPromptLine(cursor);
        scheduleNext(index);
      }
    }

    modes.forEach((mode, index) => {
      mode.addEventListener('click', () => {
        play(index, true);
      });
    });

    // Pause only while the user hovers/focuses the terminal itself, so the
    // mode buttons can switch scenes without stalling playback.
    const hoverTarget = screen.closest('.terminal') ?? screen;
    const syncPaused = () => {
      paused = hovering || userPaused;
    };
    hoverTarget.addEventListener('mouseenter', () => {
      hovering = true;
      syncPaused();
    });
    hoverTarget.addEventListener('mouseleave', () => {
      hovering = false;
      syncPaused();
    });
    hoverTarget.addEventListener('focusin', () => {
      hovering = true;
      syncPaused();
    });
    hoverTarget.addEventListener('focusout', () => {
      hovering = false;
      syncPaused();
    });

    const pauseBtn = wrapper.querySelector<HTMLButtonElement>(
      '[data-hero-pause]',
    );
    if (pauseBtn && !reduceMotion) {
      pauseBtn.hidden = false;
      pauseBtn.addEventListener('click', () => {
        userPaused = !userPaused;
        syncPaused();
        // Resuming after a scene was picked while paused replays it
        if (!userPaused && showingStatic) play(current);
        pauseBtn.setAttribute('aria-pressed', String(userPaused));
        const label = userPaused
          ? pauseBtn.dataset.labelPlay
          : pauseBtn.dataset.labelPause;
        if (label) pauseBtn.setAttribute('aria-label', label);
      });
    }

    wrapper.dataset.heroStarted = 'true';
    play(0);
  }

  document.addEventListener('astro:page-load', initHeroTerminal);
  initHeroTerminal();
</script>
