---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<div class="theme-switcher" role="radiogroup" aria-label={t.theme.ariaTheme}>
  <button
    class="theme-btn"
    data-theme-value="retro"
    title={t.theme.retro}
    aria-label={t.theme.retro}
    role="radio"
    aria-checked="false"
  >
    <!-- Game Boy: body with screen, d-pad and A/B buttons cut out -->
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" fill-rule="evenodd" shape-rendering="crispEdges" aria-hidden="true">
      <path d="M3 1h10v12l-2 2H3z M5 3h6v5H5z M6 10h1v1h1v1H7v1H6v-1H5v-1h1z M11 10h1v1h-1z M10 11h1v1h-1z"/>
    </svg>
  </button>
  <button
    class="theme-btn"
    data-theme-value="light"
    title={t.theme.light}
    aria-label={t.theme.light}
    role="radio"
    aria-checked="false"
  >
    <!-- SNES controller: dog-bone pad with d-pad and diamond buttons cut out -->
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" fill-rule="evenodd" shape-rendering="crispEdges" aria-hidden="true">
      <path d="M3 4h3v1h4V4h3v1h1v1h1v4h-1v1h-1v1h-3v-1H6v1H3v-1H2v-1H1V6h1V5h1z M4 6h1v1h1v1H5v1H4V8H3V7h1z M12 6h1v1h-1z M11 7h1v1h-1z M13 7h1v1h-1z M12 8h1v1h-1z M7 8h2v1H7z"/>
    </svg>
  </button>
  <button
    class="theme-btn"
    data-theme-value="cream"
    title={t.theme.cream}
    aria-label={t.theme.cream}
    role="radio"
    aria-checked="false"
  >
    <!-- Pixel house with a door notch -->
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
      <path d="M7 2h2v1h1v1h1v1h1v1h1v1h1v1h-2v6H9v-4H7v4H4V8H2V7h1V6h1V5h1V4h1V3h1z"/>
    </svg>
  </button>
</div>

<style>
  .theme-switcher {
    display: flex;
    gap: 2px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 2px;
  }

  .theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 24px;
    padding: 3px 5px;
    background: none;
    border: none;
    color: var(--color-text-dim);
    cursor: pointer;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .theme-btn:hover {
    color: var(--color-text);
  }

  .theme-btn.active {
    background: var(--color-primary);
    color: var(--color-btn-text);
  }
</style>

<script>
  let osThemeListener: ((e: Event) => void) | null = null;

  function initThemeSwitcher() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(
      '.theme-btn[data-theme-value]',
    );

    // Keep the browser UI (mobile address bar) matching the page background
    function syncThemeColor() {
      const bg = getComputedStyle(document.documentElement)
        .getPropertyValue('--color-bg')
        .trim();
      const meta = document.querySelector('meta[name="theme-color"]');
      if (bg && meta) meta.setAttribute('content', bg);
    }

    function syncButtons(theme: string) {
      buttons.forEach((btn) => {
        const isActive = btn.dataset.themeValue === theme;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-checked', String(isActive));
      });
    }

    // persist=true only when user explicitly clicks
    function applyTheme(theme: string, persist = true) {
      document.documentElement.setAttribute('data-theme', theme);
      syncButtons(theme);
      syncThemeColor();
      if (persist) localStorage.setItem('envilder-theme', theme);
    }

    const stored = localStorage.getItem('envilder-theme');
    // Sync buttons to the theme already applied by the inline script
    const current =
      stored ||
      document.documentElement.getAttribute('data-theme') ||
      'retro';
    applyTheme(current, false); // never store on auto-init

    // React to OS theme changes when the user hasn't explicitly chosen
    if (osThemeListener) {
      window
        .matchMedia('(prefers-color-scheme: light)')
        .removeEventListener('change', osThemeListener);
    }
    const mq = window.matchMedia('(prefers-color-scheme: light)');
    osThemeListener = (e: Event) => {
      if (!localStorage.getItem('envilder-theme')) {
        applyTheme((e as MediaQueryListEvent).matches ? 'light' : 'retro', false);
      }
    };
    mq.addEventListener('change', osThemeListener);

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const theme = btn.dataset.themeValue;
        if (theme) {
          applyTheme(theme, true); // explicit user choice → persist
        }
      });
    });
  }

  // Run on initial load
  initThemeSwitcher();

  // Re-run after Astro client-side navigation
  document.addEventListener('astro:after-swap', initThemeSwitcher);
</script>
