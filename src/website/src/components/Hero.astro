---
import { useTranslations } from '../i18n/utils';
import TerminalMockup from './TerminalMockup.astro';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

type Seg = { text: string; cls: string; instant?: boolean };
type Editor = { file: string; lang: string; code: Seg[][] };
type Line = {
  kind: 'type' | 'output' | 'blank' | 'editor' | 'pause';
  segments?: Seg[];
  editor?: Editor;
  /** For `pause`: how long the running process stays quiet. */
  ms?: number;
};
type Scene = {
  id: string;
  name: string;
  desc: string;
  icon: string;
  lines: Line[];
};

const jsonLines: Line[] = [
  { kind: 'output', segments: [{ text: '{', cls: 'output' }] },
  {
    kind: 'output',
    segments: [
      {
        text: '  "LOCALSTACK_AUTH_TOKEN": "/localstack/prod/auth-token"',
        cls: 'output',
      },
    ],
  },
  { kind: 'output', segments: [{ text: '}', cls: 'output' }] },
];

const cliRule = '━'.repeat(60);

// One LocalStack log line, with the same column padding the container uses.
const localstackLog = (
  time: string,
  logger: string,
  message: string,
  thread = '  MainThread',
): Line => ({
  kind: 'output',
  segments: [
    { text: `2026-10-16T${time}  `, cls: 'comment' },
    { text: 'INFO', cls: 'flag' },
    { text: ` --- [${thread}] `, cls: 'output' },
    { text: logger.padEnd(26), cls: 'command' },
    { text: ` : ${message}`, cls: 'output' },
  ],
});

const outputLine = (text: string, cls = 'output'): Line => ({
  kind: 'output',
  segments: [{ text, cls }],
});

const twinApp = (time: string, app: string, port: number): Line =>
  localstackLog(
    time,
    'l.pro.apps.twin_plugin',
    `Apps: ${app} ready at http://${app}.localhost.localstack.cloud:4566 -> 127.0.0.1:${port}`,
  );

const alembicPlugin = (name: string): Line =>
  localstackLog(
    '23:21:09.626',
    'alembic.runtime.plugins',
    `setup plugin alembic.${name}`,
  );

// Mirrors EnvironmentVariable.maskSecretPath: keep the last 3 characters.
const maskPath = (path: string) => '*'.repeat(path.length - 3) + path.slice(-3);

const setupScene = (opts: {
  id: string;
  icon: string;
  mapComment: string;
  pushComment: string;
  configLines: string[];
  secretPath: string;
}): Scene => ({
  id: opts.id,
  name: t.hero.tabSetup,
  desc: t.hero.tabSetupDesc,
  icon: opts.icon,
  lines: [
    {
      kind: 'type',
      segments: [{ text: opts.mapComment, cls: 'comment' }],
    },
    {
      kind: 'type',
      segments: [
        { text: '❯', cls: 'prompt', instant: true },
        { text: ' ls -a', cls: 'command' },
      ],
    },
    {
      kind: 'output',
      segments: [{ text: '.  ..  .env  envilder.json', cls: 'output' }],
    },
    {
      kind: 'type',
      segments: [
        { text: '❯', cls: 'prompt', instant: true },
        { text: ' cat ', cls: 'command' },
        { text: 'envilder.json', cls: 'flag' },
      ],
    },
    { kind: 'output', segments: [{ text: '{', cls: 'output' }] },
    ...opts.configLines.map(
      (text): Line => ({ kind: 'output', segments: [{ text, cls: 'output' }] }),
    ),
    {
      kind: 'output',
      segments: [
        {
          text: `  "LOCALSTACK_AUTH_TOKEN": "${opts.secretPath}"`,
          cls: 'output',
        },
      ],
    },
    { kind: 'output', segments: [{ text: '}', cls: 'output' }] },
    {
      kind: 'type',
      segments: [
        { text: '❯', cls: 'prompt', instant: true },
        { text: ' cat ', cls: 'command' },
        { text: '.env', cls: 'flag' },
      ],
    },
    {
      kind: 'output',
      segments: [
        { text: 'LOCALSTACK_AUTH_TOKEN', cls: 'command' },
        { text: '=example-not-a-real-secret', cls: 'output' },
      ],
    },
    { kind: 'blank' },
    {
      kind: 'type',
      segments: [{ text: opts.pushComment, cls: 'comment' }],
    },
    {
      kind: 'type',
      segments: [
        { text: '❯', cls: 'prompt', instant: true },
        { text: ' npx envilder', cls: 'command' },
        { text: ' --push', cls: 'flag' },
      ],
    },
    {
      kind: 'output',
      segments: [
        { text: 'Pushed ', cls: 'output' },
        { text: 'LOCALSTACK_AUTH_TOKEN', cls: 'command' },
        {
          text: `=*******************secret → ${maskPath(opts.secretPath)}`,
          cls: 'output',
        },
      ],
    },
    {
      kind: 'output',
      segments: [
        { text: '⭐ ', cls: 'highlight' },
        {
          text: "Successfully pushed environment variables from '.env'",
          cls: 'output',
        },
      ],
    },
  ],
});

// Syntax tokens for the in-terminal editor. Colours come from the editor's
// `data-lang`, so each stack gets its own palette.
const kw = (text: string): Seg => ({ text, cls: 'tok-kw' });
const ty = (text: string): Seg => ({ text, cls: 'tok-type' });
const fn = (text: string): Seg => ({ text, cls: 'tok-fn' });
const str = (text: string): Seg => ({ text, cls: 'tok-str' });
const p = (text: string): Seg => ({ text, cls: 'tok-plain' });
const indent = (text: string): Seg => ({
  text,
  cls: 'tok-plain',
  instant: true,
});

const sdkScene = (opts: {
  id: string;
  name: string;
  desc: string;
  icon: string;
  editor: Editor;
  run: [string, string];
  output: string;
}): Scene => ({
  id: opts.id,
  name: opts.name,
  desc: opts.desc,
  icon: opts.icon,
  lines: [
    {
      kind: 'type',
      segments: [{ text: t.hero.sdkCommentLoad, cls: 'comment' }],
    },
    {
      kind: 'type',
      segments: [
        { text: '❯', cls: 'prompt', instant: true },
        { text: ' vim ', cls: 'command' },
        { text: opts.editor.file, cls: 'flag' },
      ],
    },
    { kind: 'editor', editor: opts.editor },
    {
      kind: 'type',
      segments: [
        { text: '❯', cls: 'prompt', instant: true },
        { text: opts.run[0], cls: 'command' },
        { text: opts.run[1], cls: 'flag' },
      ],
    },
    {
      kind: 'output',
      segments: [{ text: opts.output, cls: 'output' }],
    },
  ],
});

const scenes: Scene[] = [
  setupScene({
    id: 'setup-aws',
    icon: '/AWS.svg',
    mapComment: t.hero.setupComment1,
    pushComment: t.hero.setupComment2,
    configLines: ['  "$config": { "provider": "aws" },'],
    secretPath: '/localstack/prod/auth-token',
  }),
  setupScene({
    id: 'setup-azure',
    icon: '/Azure.svg',
    mapComment: t.hero.setupAzureComment1,
    pushComment: t.hero.setupAzureComment2,
    configLines: [
      '  "$config": {',
      '    "provider": "azure",',
      '    "vaultUrl": "https://my-vault.vault.azure.net"',
      '  },',
    ],
    secretPath: 'localstack-prod-auth-token',
  }),
  {
    id: 'cli',
    name: t.hero.tabCli,
    desc: t.hero.tabCliDesc,
    icon: '/favicon.svg',
    lines: [
      {
        kind: 'type',
        segments: [{ text: t.hero.terminalComment1, cls: 'comment' }],
      },
      {
        kind: 'type',
        segments: [
          { text: '❯', cls: 'prompt', instant: true },
          { text: ' ls -a', cls: 'command' },
        ],
      },
      {
        kind: 'output',
        segments: [{ text: '.  ..  envilder.json', cls: 'output' }],
      },
      {
        kind: 'type',
        segments: [
          { text: '❯', cls: 'prompt', instant: true },
          { text: ' cat ', cls: 'command' },
          { text: 'envilder.json', cls: 'flag' },
        ],
      },
      ...jsonLines,
      { kind: 'blank' },
      {
        kind: 'type',
        segments: [{ text: t.hero.terminalComment2, cls: 'comment' }],
      },
      {
        kind: 'type',
        segments: [
          { text: '❯', cls: 'prompt', instant: true },
          { text: ' npx envilder', cls: 'command' },
          { text: ' --map', cls: 'flag' },
          { text: '=envilder.json', cls: 'command' },
          { text: ' --envfile', cls: 'flag' },
          { text: '=.env', cls: 'command' },
        ],
      },
      { kind: 'blank' },
      {
        kind: 'output',
        segments: [{ text: '🪙  RESOLVING SECRETS', cls: 'highlight' }],
      },
      {
        kind: 'output',
        segments: [{ text: cliRule, cls: 'highlight' }],
      },
      {
        kind: 'output',
        segments: [
          { text: '  ✓ ', cls: 'flag' },
          { text: 'LOCALSTACK_AUTH_TOKEN'.padEnd(22), cls: 'command' },
          { text: '→ *******************secret', cls: 'output' },
        ],
      },
      { kind: 'blank' },
      {
        kind: 'output',
        segments: [
          { text: '⭐ LEVEL CLEARED', cls: 'highlight' },
          { text: '  -  1/1 secrets loaded · ', cls: 'output' },
          { text: '.env', cls: 'command' },
          { text: ' written', cls: 'output' },
        ],
      },
      { kind: 'blank' },
      {
        kind: 'type',
        segments: [
          { text: '❯', cls: 'prompt', instant: true },
          { text: ' ls -a', cls: 'command' },
        ],
      },
      {
        kind: 'output',
        segments: [{ text: '.  ..  .env  envilder.json', cls: 'output' }],
      },
      {
        kind: 'type',
        segments: [
          { text: '❯', cls: 'prompt', instant: true },
          { text: ' cat ', cls: 'command' },
          { text: '.env', cls: 'flag' },
        ],
      },
      {
        kind: 'output',
        segments: [
          { text: 'LOCALSTACK_AUTH_TOKEN', cls: 'command' },
          { text: '=example-not-a-real-secret', cls: 'output' },
        ],
      },
    ],
  },
  {
    id: 'exec',
    name: t.hero.tabExec,
    desc: t.hero.tabExecDesc,
    icon: '/favicon.svg',
    lines: [
      {
        kind: 'type',
        segments: [{ text: t.hero.execComment1, cls: 'comment' }],
      },
      {
        kind: 'type',
        segments: [
          { text: '❯', cls: 'prompt', instant: true },
          { text: ' npx envilder', cls: 'command' },
          { text: ' exec', cls: 'flag' },
          { text: ' --', cls: 'output' },
          { text: ' docker run --rm', cls: 'command' },
          { text: ' --env', cls: 'flag' },
          { text: ' LOCALSTACK_AUTH_TOKEN', cls: 'command' },
          { text: ' localstack/localstack', cls: 'command' },
        ],
      },
      {
        kind: 'output',
        segments: [
          {
            text: 'envilder: 1 secret resolved (aws, profile=default) → ',
            cls: 'output',
          },
          { text: 'docker …', cls: 'command' },
        ],
      },
      { kind: 'pause', ms: 700 },
      { kind: 'blank' },
      outputLine('LocalStack version: 2026.10.0'),
      outputLine('LocalStack build date: 2026-10-13'),
      outputLine('LocalStack build git hash: 738d58ee'),
      { kind: 'blank' },
      outputLine('Docker not available'),
      {
        kind: 'output',
        segments: [
          { text: '2026-10-16T23:21:04.821  ', cls: 'comment' },
          { text: 'INFO', cls: 'flag' },
          { text: ' --- [  MainThread] ', cls: 'output' },
          { text: 'l.licensing.licensingv2'.padEnd(26), cls: 'command' },
          {
            text: ' : Successfully requested and activated new license ',
            cls: 'output',
          },
          {
            text: '00000000-0000-0000-0000-000000000000:ultimate',
            cls: 'flag',
          },
          { text: ' 🔑✅', cls: 'output' },
        ],
      },
      localstackLog(
        '23:21:05.607',
        'localstack.utils.bootstrap',
        'Execution of "_resolve_api_provider_specs" took 752.28ms',
      ),
      { kind: 'pause', ms: 900 },
      twinApp('23:21:09.067', 'logodev', 4115),
      twinApp('23:21:09.073', 'posthog', 4113),
      twinApp('23:21:09.079', 'resend', 4114),
      twinApp('23:21:09.086', 'stripe', 4111),
      twinApp('23:21:09.096', 'twilio', 4112),
      localstackLog(
        '23:21:09.096',
        'l.extensions.plugins',
        'loaded 0 extensions',
      ),
      { kind: 'pause', ms: 400 },
      alembicPlugin('autogenerate.schemas'),
      alembicPlugin('autogenerate.tables'),
      alembicPlugin('autogenerate.types'),
      alembicPlugin('autogenerate.constraints'),
      alembicPlugin('autogenerate.defaults'),
      alembicPlugin('autogenerate.comments'),
      alembicPlugin('ext.checkconstraint_byname'),
      outputLine('Ready.', 'highlight'),
      { kind: 'pause', ms: 1500 },
      outputLine('Localstack runtime received signal 15'),
      localstackLog(
        '23:21:15.867',
        'l.runtime.shutdown',
        '[shutdown] Stopping all services',
        'ime-Shutdown',
      ),
      { kind: 'blank' },
      {
        kind: 'type',
        segments: [{ text: t.hero.execComment2, cls: 'comment' }],
      },
      {
        kind: 'type',
        segments: [
          { text: '❯', cls: 'prompt', instant: true },
          { text: ' ls -a', cls: 'command' },
        ],
      },
      {
        kind: 'output',
        segments: [{ text: '.  ..  envilder.json', cls: 'output' }],
      },
    ],
  },
  sdkScene({
    id: 'nodejs',
    name: t.hero.tabNode,
    desc: t.hero.tabNodeDesc,
    icon: '/sdk-logo.svg',
    editor: {
      file: 'config.ts',
      lang: 'typescript',
      code: [
        [
          kw('import'),
          p(' { '),
          ty('Envilder'),
          p(' } '),
          kw('from'),
          p(' '),
          str("'@envilder/sdk'"),
          p(';'),
        ],
        [],
        [
          kw('const'),
          p(' secrets = '),
          kw('await'),
          p(' '),
          ty('Envilder'),
          p('.'),
          fn('load'),
          p('('),
          str("'envilder.json'"),
          p(');'),
        ],
        [p('console.'), fn('log'), p('(secrets);')],
      ],
    },
    run: [' node ', 'config.ts'],
    output: "Map(1) { 'LOCALSTACK_AUTH_TOKEN' => 'example-not-a-real-secret' }",
  }),
  sdkScene({
    id: 'python',
    name: t.hero.tabPython,
    desc: t.hero.tabPythonDesc,
    icon: '/sdk-python.svg',
    editor: {
      file: 'settings.py',
      lang: 'python',
      code: [
        [kw('from'), p(' envilder '), kw('import'), p(' '), ty('Envilder')],
        [],
        [
          p('secrets = '),
          ty('Envilder'),
          p('.'),
          fn('load'),
          p('('),
          str('"envilder.json"'),
          p(')'),
        ],
        [fn('print'), p('(secrets)')],
      ],
    },
    run: [' python ', 'settings.py'],
    output: "{'LOCALSTACK_AUTH_TOKEN': 'example-not-a-real-secret'}",
  }),
  sdkScene({
    id: 'dotnet',
    name: t.hero.tabDotnet,
    desc: t.hero.tabDotnetDesc,
    icon: '/sdk-dotnet.svg',
    editor: {
      file: 'Program.cs',
      lang: 'cs',
      code: [
        [kw('using'), p(' '), ty('Envilder'), p(';')],
        [],
        [
          kw('var'),
          p(' secrets = '),
          kw('await'),
          p(' '),
          ty('Env'),
          p('.'),
          fn('LoadAsync'),
          p('('),
          str('"envilder.json"'),
          p(');'),
        ],
        [
          kw('foreach'),
          p(' ('),
          kw('var'),
          p(' (key, value) '),
          kw('in'),
          p(' secrets)'),
        ],
        [p('{')],
        [
          indent('    '),
          ty('Console'),
          p('.'),
          fn('WriteLine'),
          p('('),
          str('$"{key} = {value}"'),
          p(');'),
        ],
        [p('}')],
      ],
    },
    run: [' dotnet ', 'run'],
    output: 'LOCALSTACK_AUTH_TOKEN = example-not-a-real-secret',
  }),
];

// Escape `<` so the serialized scenes can never break out of the
// <script type="application/json"> tag (e.g. a stray "</script>").
const scenesJson = JSON.stringify(scenes).replace(/</g, '\\u003c');
---

<section class="hero scanlines" id="hero">
  <div class="container hero-container">
    <div class="hero-content">
      <h1 class="hero-title">
        {t.hero.title1}<br />
        {t.hero.title2}<br />
        <span class="hero-accent">{t.hero.titleAccent}</span>
      </h1>

      <p class="hero-description">
        {t.hero.description}
      </p>
      <p class="hero-positioning">{t.hero.positioning}</p>

      <div class="hero-tech-line">
        <strong>{t.hero.descAws}</strong> {t.hero.descOr} <strong>{t.hero.descAzure}</strong>{t.hero.descSuffix}
      </div>

      <div class="hero-actions">
        <a
          href="#get-started"
          class="btn btn-primary"
          data-analytics-event="click_get_started"
        >
          {t.hero.getStarted}
        </a>
        <a
          href="https://github.com/macalbert/envilder"
          class="btn btn-outline"
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="click_github"
          data-analytics-placement="hero"
        >
          {t.hero.viewOnGithub}
        </a>
      </div>

      <div class="hero-install">
        <code class="install-cmd">
          <span class="prompt">❯</span> npm install -g envilder
        </code>
      </div>
    </div>

    <div class="hero-terminal">
      <TerminalMockup title="envilder" icon>
        <div class="hero-term-screen" data-hero-screen aria-live="off">
          {scenes[0].lines.map((line) =>
            line.kind === 'blank' ? (
              <span class="line">&nbsp;</span>
            ) : (
              <span class="line">
                {line.segments?.map((seg) => (
                  <span class={seg.cls}>{seg.text}</span>
                ))}
              </span>
            ),
          )}
          <span class="line"><span class="prompt">❯</span><span class="cursor"></span></span>
        </div>
      </TerminalMockup>

      <script
        type="application/json"
        id="hero-term-data"
        set:html={scenesJson}
      />

      <div
        class="hero-term-modes"
        role="group"
        aria-label={t.hero.terminalSceneLabel}
      >
        {scenes.map((scene, i) => (
          <button
            class:list={['hero-term-mode', { active: i === 0 }]}
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-hero-mode={scene.id}
            type="button"
          >
            <img
              src={scene.icon}
              alt=""
              class="hero-term-mode-icon"
              width="18"
              height="18"
            />
            <span class="hero-term-mode-name">{scene.name}</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="hero-gradient"></div>
</section>

<style>
  .hero {
    padding-top: calc(var(--nav-height) + var(--space-4xl));
    padding-bottom: var(--space-4xl);
    position: relative;
    overflow: hidden;
  }

  .hero-gradient {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 600px;
    background: radial-gradient(
      ellipse at center,
      rgba(138, 154, 108, 0.08) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3xl);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .hero-title {
    font-size: clamp(1.2rem, 4vw, 1.8rem);
    line-height: 1.5;
  }

  .hero-accent {
    color: var(--color-primary);
  }

  .hero-description {
    font-size: 1.1rem;
    line-height: 1.8;
    max-width: 520px;
  }

  .hero-description strong {
    color: var(--color-secondary);
  }

  .hero-positioning {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    max-width: 560px;
  }

  .hero-tech-line {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }

  .hero-tech-line strong {
    color: var(--color-secondary);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .hero-install {
    margin-top: var(--space-sm);
  }

  .install-cmd {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    background: var(--color-code-bg);
    border: 1px solid var(--color-border);
    padding: var(--space-sm) var(--space-md);
    display: inline-block;
  }

  .install-cmd .prompt {
    color: var(--color-prompt);
    font-weight: 700;
  }

  .hero-terminal {
    width: 100%;
  }

  .hero-term-screen {
    display: block;
    height: 21em;
    overflow: hidden;
  }

  .hero-term-screen :global(.line) {
    display: block;
    min-height: 1.8em;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* 12-column grid: the setup/CLI/exec row holds four tabs and the SDK row
     holds three, each row filling the full width. */
  .hero-term-modes {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .hero-term-mode {
    grid-column: span 3;
  }

  .hero-term-mode:nth-child(n + 5) {
    grid-column: span 4;
  }

  .hero-term-mode {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    min-width: 0;
    padding: var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .hero-term-mode:hover {
    color: var(--color-text);
    background: var(--color-surface-alt);
    border-color: var(--color-border-light, var(--color-border));
  }

  .hero-term-mode.active {
    color: var(--color-text);
    border-color: var(--color-primary);
    background: var(--color-surface-alt);
  }

  .hero-term-mode-icon {
    width: 18px;
    height: 18px;
    object-fit: contain;
    flex-shrink: 0;
    opacity: 0.5;
    transition: opacity 0.2s;
  }

  .hero-term-mode.active .hero-term-mode-icon {
    opacity: 1;
  }

  .hero-term-mode-name {
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* In-terminal editor for the SDK scenes. Each stack sets its own accent
     and syntax palette through data-lang. */
  .hero-term-screen :global(.vim) {
    --vim-accent: var(--term-highlight);
    --vim-accent-text: var(--term-header);
    --tok-kw: var(--term-highlight);
    --tok-type: var(--term-path);
    --tok-fn: var(--term-yellow);
    --tok-str: var(--term-flag);
    display: flex;
    flex-direction: column;
    height: 100%;
    white-space: pre;
  }

  .hero-term-screen :global(.vim[data-lang='typescript']) {
    --vim-accent: #3178c6;
    --vim-accent-text: #ffffff;
    --tok-kw: #569cd6;
    --tok-type: #4ec9b0;
    --tok-fn: #dcdcaa;
    --tok-str: #ce9178;
  }

  .hero-term-screen :global(.vim[data-lang='python']) {
    --vim-accent: #ffd43b;
    --vim-accent-text: #1e1e2e;
    --tok-kw: #ffd43b;
    --tok-type: #7aa7e0;
    --tok-fn: #8ec07c;
    --tok-str: #e5a46b;
  }

  .hero-term-screen :global(.vim[data-lang='cs']) {
    --vim-accent: #7c4dff;
    --vim-accent-text: #ffffff;
    --tok-kw: #a78bfa;
    --tok-type: #4ec9b0;
    --tok-fn: #dcdcaa;
    --tok-str: #d69d85;
  }

  .hero-term-screen :global(.vim.is-static) {
    height: auto;
    margin-bottom: var(--space-sm);
  }

  .hero-term-screen :global(.vim-buffer) {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .hero-term-screen :global(.vim-line),
  .hero-term-screen :global(.vim-tilde) {
    display: block;
    min-height: 1.8em;
  }

  .hero-term-screen :global(.vim-num) {
    display: inline-block;
    width: 3ch;
    margin-right: 1.5ch;
    text-align: right;
    color: var(--term-dim);
  }

  .hero-term-screen :global(.vim-tilde) {
    color: var(--term-border);
  }

  .hero-term-screen :global(.vim.is-static .vim-tildes) {
    display: none;
  }

  .hero-term-screen :global(.tok-kw) { color: var(--tok-kw); }
  .hero-term-screen :global(.tok-type) { color: var(--tok-type); }
  .hero-term-screen :global(.tok-fn) { color: var(--tok-fn); }
  .hero-term-screen :global(.tok-str) { color: var(--tok-str); }
  .hero-term-screen :global(.tok-plain) { color: var(--term-text); }

  .hero-term-screen :global(.vim-status) {
    display: flex;
    background: var(--term-header);
    color: var(--term-muted);
    font-size: 0.75rem;
    line-height: 1.8;
  }

  .hero-term-screen :global(.vim-mode),
  .hero-term-screen :global(.vim-pos) {
    padding: 0 1ch;
    background: var(--vim-accent);
    color: var(--vim-accent-text);
    font-weight: 700;
  }

  .hero-term-screen :global(.vim-file),
  .hero-term-screen :global(.vim-lang) {
    padding: 0 1ch;
  }

  .hero-term-screen :global(.vim-lang) {
    color: var(--vim-accent);
  }

  .hero-term-screen :global(.vim-spacer) {
    flex: 1;
  }

  .hero-term-screen :global(.vim-cmd) {
    min-height: 1.8em;
    color: var(--term-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-term-screen :global(.cursor) {
      animation: none;
    }
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  type Seg = { text: string; cls: string; instant?: boolean };
  type Editor = { file: string; lang: string; code: Seg[][] };
  type Line = {
    kind: 'type' | 'output' | 'blank' | 'editor' | 'pause';
    segments?: Seg[];
    editor?: Editor;
    ms?: number;
  };
  type Scene = { id: string; name: string; desc: string; lines: Line[] };

  function initHeroTerminal() {
    const wrapper = document.querySelector<HTMLElement>('.hero-terminal');
    if (!wrapper || wrapper.dataset.heroTermInit) return;

    const screen = wrapper.querySelector<HTMLElement>('[data-hero-screen]');
    const dataEl = wrapper.querySelector<HTMLElement>('#hero-term-data');
    const modes = Array.from(
      wrapper.querySelectorAll<HTMLButtonElement>('.hero-term-mode'),
    );
    if (!screen || !dataEl || modes.length === 0) return;

    let scenes: Scene[];
    try {
      scenes = JSON.parse(dataEl.textContent || '[]') as Scene[];
    } catch {
      return;
    }
    if (scenes.length === 0) return;

    wrapper.dataset.heroTermInit = 'true';

    // Each init claims a global generation token. Any previously running
    // playback loop (e.g. left over from an Astro view transition) sees a
    // newer generation and bails out, so only one loop ever drives the screen.
    const globalState = window as unknown as { __heroTermGen?: number };
    const generation = (globalState.__heroTermGen ?? 0) + 1;
    globalState.__heroTermGen = generation;
    const isStale = () => generation !== globalState.__heroTermGen;

    // Astro client-side navigation may swap to a page without this script, so
    // no new init runs to claim a fresh generation. Bumping the token on
    // `astro:after-swap` makes any pending scheduleNext() autoplay go stale
    // immediately, preventing timers from firing against a detached DOM.
    document.addEventListener(
      'astro:after-swap',
      () => {
        globalState.__heroTermGen = (globalState.__heroTermGen ?? 0) + 1;
      },
      { once: true },
    );

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    let runId = 0;
    let current = 0;
    let paused = false;
    let holdTimer: ReturnType<typeof setTimeout> | undefined;
    let scrollFrame: number | undefined;

    const sleep = (ms: number) =>
      new Promise<void>((resolve) => setTimeout(resolve, ms));

    function waitWhilePaused(): Promise<void> {
      if (!paused || isStale()) return Promise.resolve();
      return new Promise<void>((resolve) => {
        const check = () => {
          if (paused && !isStale()) {
            setTimeout(check, 120);
          } else {
            resolve();
          }
        };
        check();
      });
    }

    // Playback timing (ms). Every scene shares these so the rhythm stays
    // consistent; the jitter makes the typing read as a person at a keyboard.
    const TIMING = {
      sceneHold: 3000,
      thinkAfterPrompt: [250, 450],
      enterAfterCommand: [450, 700],
      enterAfterComment: [250, 400],
      outputSettle: [300, 450],
      blankLine: 120,
      editorOpen: 600,
      editorNewline: [120, 220],
      editorModeSwitch: [300, 450],
    } as const;

    const between = ([min, max]: readonly [number, number]) =>
      min + Math.random() * (max - min);

    // Roughly bell-shaped around 40ms per key, slower at word boundaries and
    // punctuation, with an occasional short hesitation mid-word.
    function keyDelay(ch: string): number {
      const base = 28 + (Math.random() + Math.random()) * 12;
      if (ch === ' ') return base + between([40, 100]);
      if (/[=\-/.,:'"(){}]/.test(ch)) return base + between([15, 45]);
      if (Math.random() < 0.03) return base + between([120, 260]);
      return base;
    }

    function setActiveMode(index: number) {
      modes.forEach((m, i) => {
        const active = i === index;
        m.classList.toggle('active', active);
        m.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    function keepLatestLineVisible(): void {
      if (scrollFrame !== undefined) return;
      scrollFrame = window.requestAnimationFrame(() => {
        const top = screen!.scrollHeight - screen!.clientHeight;
        if (top > screen!.scrollTop) {
          screen!.scrollTo({ top, behavior: 'smooth' });
        }
        scrollFrame = undefined;
      });
    }

    function makeLineEl(): HTMLElement {
      const el = document.createElement('span');
      el.className = 'line';
      screen!.appendChild(el);
      keepLatestLineVisible();
      return el;
    }

    function renderInstant(scene: Scene) {
      screen!.innerHTML = '';
      for (const line of scene.lines) {
        if (line.kind === 'editor') {
          screen!.appendChild(renderEditorStatic(line.editor!));
          continue;
        }
        if (line.kind === 'pause') continue;
        const el = makeLineEl();
        if (line.kind === 'blank') {
          el.innerHTML = '&nbsp;';
          continue;
        }
        for (const seg of line.segments || []) {
          const span = document.createElement('span');
          span.className = seg.cls;
          span.textContent = seg.text;
          el.appendChild(span);
        }
      }
      const prompt = makeLineEl();
      prompt.innerHTML =
        '<span class="prompt">❯</span><span class="cursor"></span>';
      keepLatestLineVisible();
    }

    function scheduleNext(index: number) {
      if (reduceMotion) return;
      holdTimer = setTimeout(() => {
        play((index + 1) % scenes.length);
      }, TIMING.sceneHold);
    }

    // A playback is "alive" while it owns the current run id and no newer
    // generation has superseded it. Centralising the guard keeps every loop
    // body simple (complexity 1 instead of repeated `||` checks).
    function alive(id: number): boolean {
      return id === runId && !isStale();
    }

    function appendSeg(el: HTMLElement, seg: Seg, before?: Node): HTMLElement {
      const span = document.createElement('span');
      span.className = seg.cls;
      if (before) {
        el.insertBefore(span, before);
      } else {
        el.appendChild(span);
      }
      return span;
    }

    // Prints consecutive output lines in one shot and returns the next index.
    function dumpOutputRun(lines: Line[], start: number): number {
      let i = start;
      while (i < lines.length && lines[i].kind === 'output') {
        const el = makeLineEl();
        for (const seg of lines[i].segments ?? []) {
          appendSeg(el, seg).textContent = seg.text;
        }
        i += 1;
      }
      return i;
    }

    async function typeSegment(
      el: HTMLElement,
      seg: Seg,
      cursor: HTMLElement,
      id: number,
    ): Promise<boolean> {
      const span = appendSeg(el, seg, cursor);
      if (seg.instant) {
        span.textContent = seg.text;
        keepLatestLineVisible();
        // The prompt appears at once; give the "user" a beat before typing.
        if (seg.cls === 'prompt') await sleep(between(TIMING.thinkAfterPrompt));
        return true;
      }
      for (const ch of seg.text) {
        await waitWhilePaused();
        if (!alive(id)) return false;
        span.textContent += ch;
        keepLatestLineVisible();
        await sleep(keyDelay(ch));
      }
      return true;
    }

    async function typeCommandLine(
      line: Line,
      cursor: HTMLElement,
      id: number,
    ): Promise<boolean> {
      const el = makeLineEl();
      el.appendChild(cursor);
      for (const seg of line.segments ?? []) {
        if (!(await typeSegment(el, seg, cursor, id))) return false;
      }
      // Mini pause for pressing Enter; a command also "runs" for a moment.
      const isCommand = line.segments?.[0]?.instant === true;
      await sleep(
        between(
          isCommand ? TIMING.enterAfterCommand : TIMING.enterAfterComment,
        ),
      );
      return true;
    }

    function appendBlankLine(): void {
      makeLineEl().innerHTML = '&nbsp;';
    }

    function appendPromptLine(cursor: HTMLElement): void {
      const prompt = makeLineEl();
      const dollar = document.createElement('span');
      dollar.className = 'prompt';
      dollar.textContent = '❯';
      prompt.appendChild(dollar);
      prompt.appendChild(cursor);
    }

    type EditorView = {
      root: HTMLElement;
      buffer: HTMLElement;
      tildes: HTMLElement;
      mode: HTMLElement;
      pos: HTMLElement;
      cmd: HTMLElement;
    };

    function mk(tag: string, cls: string, text = ''): HTMLElement {
      const node = document.createElement(tag);
      node.className = cls;
      node.textContent = text;
      return node;
    }

    // A vim-like editor: numbered buffer, `~` filler, status line, cmdline.
    function buildEditor(editor: Editor): EditorView {
      const root = mk('div', 'vim');
      root.dataset.lang = editor.lang;
      const buffer = mk('div', 'vim-buffer');
      const tildes = mk('div', 'vim-tildes');
      for (let i = 0; i < 20; i++) tildes.appendChild(mk('span', 'vim-tilde', '~'));
      buffer.appendChild(tildes);
      const status = mk('div', 'vim-status');
      const mode = mk('span', 'vim-mode', 'NORMAL');
      const pos = mk('span', 'vim-pos', '1:1');
      status.append(
        mode,
        mk('span', 'vim-file', editor.file),
        mk('span', 'vim-spacer'),
        mk('span', 'vim-lang', editor.lang),
        pos,
      );
      const cmd = mk('div', 'vim-cmd');
      root.append(buffer, status, cmd);
      return { root, buffer, tildes, mode, pos, cmd };
    }

    // Adds buffer line `n` and returns the element that holds its code.
    function addEditorLine(view: EditorView, n: number): HTMLElement {
      const line = mk('div', 'vim-line');
      const code = mk('span', 'vim-code');
      line.append(mk('span', 'vim-num', String(n)), code);
      view.buffer.insertBefore(line, view.tildes);
      return code;
    }

    function setEditorMode(view: EditorView, insert: boolean): void {
      view.mode.textContent = insert ? 'INSERT' : 'NORMAL';
      view.root.classList.toggle('is-insert', insert);
      view.cmd.textContent = insert ? '-- INSERT --' : '';
    }

    function renderEditorStatic(editor: Editor): HTMLElement {
      const view = buildEditor(editor);
      view.root.classList.add('is-static');
      editor.code.forEach((row, r) => {
        const code = addEditorLine(view, r + 1);
        for (const seg of row) appendSeg(code, seg).textContent = seg.text;
      });
      return view.root;
    }

    // Opens the editor full screen (like vim's alternate screen), types the
    // file in INSERT mode, saves with `:wq` and restores the shell.
    async function playEditor(
      editor: Editor,
      cursor: HTMLElement,
      id: number,
    ): Promise<boolean> {
      const shell = Array.from(screen!.childNodes);
      const view = buildEditor(editor);
      screen!.replaceChildren(view.root);
      screen!.scrollTop = 0;

      let code = addEditorLine(view, 1);
      code.appendChild(cursor);
      view.cmd.textContent = `"${editor.file}" [New]`;
      await sleep(TIMING.editorOpen);
      if (!alive(id)) return false;

      setEditorMode(view, true);
      await sleep(between(TIMING.editorModeSwitch));

      for (const [r, row] of editor.code.entries()) {
        if (r > 0) {
          await sleep(between(TIMING.editorNewline));
          code = addEditorLine(view, r + 1);
          code.appendChild(cursor);
        }
        view.pos.textContent = `${r + 1}:1`;
        for (const seg of row) {
          if (!(await typeSegment(code, seg, cursor, id))) return false;
        }
        view.pos.textContent = `${r + 1}:${code.textContent!.length + 1}`;
      }

      await sleep(between(TIMING.editorModeSwitch));
      if (!alive(id)) return false;
      setEditorMode(view, false);
      await sleep(between(TIMING.editorModeSwitch));

      view.cmd.appendChild(cursor);
      const save = { text: ':wq', cls: 'tok-plain' };
      if (!(await typeSegment(view.cmd, save, cursor, id))) return false;
      await sleep(between(TIMING.enterAfterCommand));
      if (!alive(id)) return false;

      screen!.replaceChildren(...shell);
      keepLatestLineVisible();
      return true;
    }

    // Renders a single line and returns the next index, or -1 if a newer
    // run superseded this one.
    async function playLine(
      lines: Line[],
      i: number,
      cursor: HTMLElement,
      id: number,
    ): Promise<number> {
      const line = lines[i];

      if (line.kind === 'output') {
        const next = dumpOutputRun(lines, i);
        // Let the output land before the next keystroke.
        await sleep(between(TIMING.outputSettle));
        return next;
      }

      if (line.kind === 'blank') {
        appendBlankLine();
        await sleep(TIMING.blankLine);
        return i + 1;
      }

      if (line.kind === 'editor') {
        if (!(await playEditor(line.editor!, cursor, id))) return -1;
        return i + 1;
      }

      if (line.kind === 'pause') {
        await sleep(line.ms ?? 0);
        return i + 1;
      }

      if (!(await typeCommandLine(line, cursor, id))) return -1;
      return i + 1;
    }

    // Plays one scene to completion. Returns false if a newer run took over.
    async function playScene(
      scene: Scene,
      cursor: HTMLElement,
      id: number,
    ): Promise<boolean> {
      const lines = scene.lines;
      let i = 0;
      while (i < lines.length) {
        await waitWhilePaused();
        if (!alive(id)) return false;
        i = await playLine(lines, i, cursor, id);
        if (i < 0) return false;
      }
      return true;
    }

    async function play(index: number) {
      if (isStale()) return;
      const id = ++runId;
      if (holdTimer) clearTimeout(holdTimer);
      current = index;
      setActiveMode(index);

      const scene = scenes[index];
      if (reduceMotion) {
        renderInstant(scene);
        return;
      }

      // Wait for any pause to lift before clearing the screen, so an
      // auto-rotation that fires while the user is hovering does not blank
      // the terminal until they unpause.
      await waitWhilePaused();
      if (!alive(id)) return;

      screen!.innerHTML = '';
      screen!.scrollTop = 0;
      const cursor = document.createElement('span');
      cursor.className = 'cursor';

      if (await playScene(scene, cursor, id)) {
        if (!alive(id)) return;
        appendPromptLine(cursor);
        scheduleNext(index);
      }
    }

    modes.forEach((mode, index) => {
      mode.addEventListener('click', () => {
        play(index);
      });
    });

    // Pause only while the user hovers/focuses the terminal itself, so the
    // mode buttons can switch scenes without stalling playback.
    const hoverTarget = screen.closest('.terminal') ?? screen;
    hoverTarget.addEventListener('mouseenter', () => {
      paused = true;
    });
    hoverTarget.addEventListener('mouseleave', () => {
      paused = false;
    });
    hoverTarget.addEventListener('focusin', () => {
      paused = true;
    });
    hoverTarget.addEventListener('focusout', () => {
      paused = false;
    });

    wrapper.dataset.heroStarted = 'true';
    play(0);
  }

  document.addEventListener('astro:page-load', initHeroTerminal);
  initHeroTerminal();
</script>
