---
import { useTranslations } from '../i18n/utils';
import PixelSprite from './PixelSprite.astro';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section class="section" id="features">
  <div class="container">
    <div class="section-title">
      <h2>{t.features.title}<span>{t.features.titleAccent}</span></h2>
      <p class="section-subtitle">
        {t.features.subtitle}
      </p>
    </div>

    <!-- 2x2 grid of highlights -->
    <div class="grid-2 highlights-grid">
      {t.features.highlights.map((f) => (
        <div class:list={['pixel-card', 'highlight-card', { 'feature-coming-soon': f.badge }]}>
          <div class="highlight-card-header">
            <PixelSprite name={f.icon} />
            <div class="feature-title-row">
              <h3>{f.title}</h3>
              {f.badge && <span class="badge badge-small">{f.badge}</span>}
            </div>
          </div>
          <p>{f.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .highlight-card h3 {
    margin-bottom: 0;
    color: var(--color-text);
  }

  .highlight-card p {
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .highlight-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .highlight-card-header :global(.pixel-sprite) {
    margin-bottom: 0;
    flex-shrink: 0;
  }

  .feature-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .feature-coming-soon {
    opacity: 0.85;
    filter: grayscale(0.4);
  }

  .badge-small {
    font-size: 0.55rem;
    padding: 2px 6px;
  }

</style>
