  - uses: aws-actions/configure-aws-credentials@v6
    with:
      role-to-assume: arn:aws:iam::123456789012:role/GitHubActionsRole
      aws-region: us-east-1
  - run: npx envilder exec -- npm test`;

const execPackageJson = `{
  "scripts": {
    "dev": "envilder exec -- vite",
    "start": "envilder exec --map=config/prod.json -- node server.js"
  }
}`;

const execUses = `${ex.usesComment1}
envilder exec -- docker run --rm -e LOCALSTACK_AUTH_TOKEN -p 4566:4566 localstack/localstack:stable
envilder exec -- docker compose up

${ex.usesComment2}
envilder exec -- npm test

${ex.usesComment3}
envilder exec -- npx prisma migrate deploy

${ex.usesComment4}
envilder exec -- terraform plan

${ex.usesComment5}
envilder exec -- sh -c 'npm run migrate && exec npm start'`;

const execErrors = [
  {
    message:
      'error: Missing command. Usage: envilder exec [options] [--] <command> [args...]',
    fix: 'errMissingFix',
  },
  {
    message: "error: unknown option '--mapp' (Did you mean --map?)",
    fix: 'errUnknownFix',
  },
  {
    message:
      'No map file found. Provide --map or create envilder.json in the current directory.',
    fix: 'errNoMapFix',
  },
  { message: 'Command not found: vitee', fix: 'errNotFoundFix' },
  { message: 'Permission denied: ./run.sh', fix: 'errPermissionFix' },
  {
    message:
      'Map file declares variables that differ only by case (API_KEY, api_key); Windows treats them as the same variable.',
    fix: 'errCaseFix',
  },
  {
    message:
      'Secret for API_TOKEN contains a NUL byte and cannot be passed as an environment variable.',
    fix: 'errNulFix',
  },
] as const;
---

<DocsShell lang={lang} routeKey={routeKey}>
  {routeKey === 'getting-started' && (
    <>
      <section id="overview" class="docs-section">
        <h2>{gs.overviewTitle}</h2>
        <ol class="docs-list">
          {gs.overviewSteps.map((step) => <li>{step}</li>)}
        </ol>
      </section>

      <section id="requirements" class="docs-section">
        <h2>{gs.prereqTitle}</h2>
        <ul class="docs-list">
          <li>{gs.prereqNode}</li>
          <li><strong>{gs.tabAws}:</strong> {gs.prereqAws} <a href={localizedPath(lang, '/docs/providers/aws-ssm/')}>{gs.prereqAwsLink}</a></li>
          <li><strong>{gs.tabAzure}:</strong> {gs.prereqAzure} <a href={localizedPath(lang, '/docs/providers/azure-key-vault/')}>{gs.prereqAzureLink}</a></li>
        </ul>
        <p class="note">{gs.prereqWrite}</p>
      </section>

      <section id="installation" class="docs-section">
        <h2>{gs.installTitle}</h2>
        <p>{gs.installDesc}</p>
        <TabbedCodeBlock tabs={gsInstallTabs} />
        <p>{gs.installVerify}</p>
        <CodeBlock lang="bash" code="envilder --version" />
        <CodeBlock lang="text" code={__APP_VERSION__} />
      </section>

      <section id="store-secret" class="docs-section">
        <h2>{gs.secretTitle}</h2>
        <p>{gs.secretDesc}</p>
        <TabbedCodeBlock tabs={[
          { label: gs.tabAws, lang: 'bash', code: gsAwsSecret, note: gs.secretAwsNote },
          { label: gs.tabAzure, lang: 'bash', code: gsAzureSecret, note: gs.secretAzureNote },
        ]} />
      </section>

      <section id="write-map" class="docs-section">
        <h2>{gs.mapTitle}</h2>
        <p>{gs.mapDesc}</p>
        <TabbedCodeBlock tabs={[
          { label: gs.tabAws, lang: 'json', filename: 'envilder.json', code: gsAwsMap },
          { label: gs.tabAzure, lang: 'json', filename: 'envilder.json', code: gsAzureMap },
        ]} />
        <p>{gs.mapNote}</p>
      </section>

      <section id="run-exec" class="docs-section">
        <h2>{gs.runTitle}</h2>
        <p>{gs.runDesc}</p>
        <CodeBlock lang="typescript" filename="app.js" code={gsAppJs} />
        <CodeBlock lang="bash" code="envilder exec -- node app.js" />
        <p>{gs.runOutput}</p>
        <TabbedCodeBlock tabs={[
          { label: gs.tabAws, lang: 'text', code: gsExecOutputAws },
          { label: gs.tabAzure, lang: 'text', code: gsExecOutputAzure },
        ]} />
        <p>{gs.runExplain}</p>
        <p>{gs.runScriptDesc}</p>
        <CodeBlock lang="json" filename="package.json" code={gsPackageJson} />
      </section>

      <section id="pull-env" class="docs-section">
        <h2>{gs.pullTitle}</h2>
        <p>{gs.pullDesc}</p>
        <CodeBlock lang="bash" code="envilder" />
        <p>{gs.pullOutput}</p>
        <CodeBlock lang="text" code={gsPullOutput} />
        <CodeBlock lang="dotenv" filename=".env" code="DB_PASSWORD=local-dev-password" />
        <div class="callout callout-warning">
          <span class="callout-icon">⚠️</span>
          <div>{gs.pullWarn}</div>
        </div>
      </section>

      <section id="first-run-errors" class="docs-section">
        <h2>{gs.errorsTitle}</h2>
        <p>{gs.errorsIntro}</p>
        {gsErrors.map((error) => (
          <>
            <h3>{gs[error.title]}</h3>
            <CodeBlock lang="text" code={error.message} />
            <p>{gs[error.fix]}</p>
          </>
        ))}
      </section>

      <section id="next-steps" class="docs-section">
        <h2>{gs.nextTitle}</h2>
        <ul class="docs-list">
          <li><a href={localizedPath(lang, '/docs/map-file/')}>{gs.nextMap}</a></li>
          <li><a href={localizedPath(lang, '/docs/cli/exec/')}>{gs.nextExec}</a></li>
          <li><a href={localizedPath(lang, '/docs/cli/pull/')}>{gs.nextPull}</a></li>
        </ul>
      </section>
    </>
  )}

  {routeKey === 'aws-ssm' && (
    <>
      <section id="aws-setup" class="docs-section">
        <h2>{t.docs.awsSetupTitle}</h2>
        <p>{t.docs.awsSetupIntro}</p>

        <h3>{t.docs.awsSetupCredTitle}</h3>
        <p>{t.docs.awsSetupCredDesc}</p>
        <CodeBlock lang="bash" code="aws configure" />
        <p>{t.docs.awsSetupCredProfile}</p>
        <CodeBlock lang="bash" code="aws configure --profile dev-account" />

        <h3>{t.docs.awsSetupPermTitle}</h3>
        <p>{t.docs.awsSetupPermDesc}</p>
        <table class="docs-table">
          <thead>
            <tr><th>{t.docs.awsSetupPermOperation}</th><th>{t.docs.awsSetupPermPermission}</th></tr>
          </thead>
          <tbody>
            <tr><td>{t.docs.awsSetupPermPull}</td><td><code>ssm:GetParameter</code></td></tr>
            <tr><td>{t.docs.awsSetupPermPush}</td><td><code>ssm:PutParameter</code></td></tr>
          </tbody>
        </table>
        <p>{t.docs.awsSetupPolicyExample}</p>
        <CodeBlock lang="json" code={`{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Action": ["ssm:GetParameter", "ssm:PutParameter"],
    "Resource": "arn:aws:ssm:us-east-1:123456789012:parameter/myapp/*"
  }]
}`} />

        <h3>{t.docs.awsSetupVerifyTitle}</h3>
        <p>{t.docs.awsSetupVerifyDesc}</p>
        <CodeBlock lang="bash" code={awsVerifyCmd} />
        <p class="note">{t.docs.awsSetupVerifySuccess}</p>
        <p>{t.docs.awsSetupVerifySdk}</p>
        <CodeBlock lang="python" code={`from envilder import Envilder

secrets = Envilder.load("aws-test-map.json")
print(secrets["HELLO"])  # world`} />
      </section>
    </>
  )}

  {routeKey === 'azure-key-vault' && (
    <>
      <section id="azure-setup" class="docs-section">
        <h2>{t.docs.azureSetupTitle}</h2>
        <p>{t.docs.azureSetupIntro}</p>

        <h3>{t.docs.azureSetupCredTitle}</h3>
        <p>{t.docs.azureSetupCredDesc}</p>
        <CodeBlock lang="bash" code="az login" />
        <p>{t.docs.azureSetupCredVault}</p>

        <h3>{t.docs.azureSetupAccessTitle}</h3>
        <p>{t.docs.azureSetupCheck}</p>
        <CodeBlock lang="bash" code={azVaultShow} />
        <ul class="docs-list">
          <li><strong>{t.docs.azureRbacTrue}</strong></li>
          <li><strong>{t.docs.azureRbacFalse}</strong></li>
        </ul>

        <h4>{t.docs.azureOptionA}</h4>
        <CodeBlock lang="bash" code={azRbacAssign} />

        <h4>{t.docs.azureOptionB}</h4>
        <CodeBlock lang="bash" code={azVaultPolicy} />

        <h3>{t.docs.azureSetupPermTitle}</h3>
        <table class="docs-table">
          <thead>
            <tr><th>{t.docs.azureSetupPermOperation}</th><th>{t.docs.azureSetupPermPermission}</th></tr>
          </thead>
          <tbody>
            <tr><td>{t.docs.azureSetupPermPull}</td><td><strong>Get</strong></td></tr>
            <tr><td>{t.docs.azureSetupPermPush}</td><td><strong>Set</strong></td></tr>
          </tbody>
        </table>
        <p class="note">{t.docs.azureSetupPullNote}</p>

        <h3>{t.docs.azureSetupVerifyTitle}</h3>
        <p>{t.docs.azureSetupVerifyDesc}</p>
        <CodeBlock lang="bash" code={azureVerifyCmd} />
        <p class="note">{t.docs.azureSetupVerifySuccess}</p>
        <p>{t.docs.azureSetupVerifySdk}</p>
        <CodeBlock lang="python" code={`from envilder import Envilder

secrets = Envilder.load("azure-test-map.json")
print(secrets["HELLO"])  # world`} />
      </section>
    </>
  )}

  {routeKey === 'map-file' && (
    <>
      <section id="map-prerequisites" class="docs-section">
        <h2>{mf.prereqTitle}</h2>
        <p>{mf.prereqDesc}</p>
      </section>

      <section id="mapping-file" class="docs-section">
        <h2>{mf.structureTitle}</h2>
        <p>{mf.structureDesc}</p>
        <CodeBlock lang="json" filename="envilder.json" code={mfFullExample} />
        <table class="docs-table">
          <thead>
            <tr><th>{mf.thKey}</th><th>{mf.thMeaning}</th></tr>
          </thead>
          <tbody>
            <tr><td><code>$schema</code></td><td>{mf.keySchema}</td></tr>
            <tr><td><code>$config</code></td><td>{mf.keyConfig}</td></tr>
            <tr><td><code>$…</code></td><td>{mf.keyOtherDollar}</td></tr>
            <tr><td><code>DB_PASSWORD</code></td><td>{mf.keyVariable}</td></tr>
          </tbody>
        </table>
      </section>

      <section id="config-fields" class="docs-section">
        <h2>{mf.configTitle}</h2>
        <p>{mf.configDesc}</p>
        <table class="docs-table">
          <thead>
            <tr><th>{mf.thField}</th><th>{mf.thValues}</th><th>{mf.thDefault}</th><th>{mf.thBehaviour}</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><code>provider</code></td>
              <td><code>aws</code> | <code>azure</code></td>
              <td><code>aws</code></td>
              <td>{mf.fieldProvider}</td>
            </tr>
            <tr>
              <td><code>profile</code></td>
              <td>{mf.valueProfileName}</td>
              <td>{mf.defaultProfile}</td>
              <td>{mf.fieldProfile}</td>
            </tr>
            <tr>
              <td><code>vaultUrl</code></td>
              <td><code>https://&lt;vault&gt;.vault.azure.net</code></td>
              <td>-</td>
              <td>{mf.fieldVaultUrl}</td>
            </tr>
          </tbody>
        </table>
        <p class="note">{mf.configSdkNote}</p>
      </section>

      <section id="providers" class="docs-section">
        <h2>{mf.providersTitle}</h2>
        <h3>{mf.awsTitle}</h3>
        <p>{mf.awsDesc}</p>
        <CodeBlock lang="json" filename="envilder.json" code={mfAwsExample} />
        <h3>{mf.azureTitle}</h3>
        <p>{mf.azureDesc}</p>
        <CodeBlock lang="json" filename="envilder.json" code={mfAzureExample} />
        <ul class="docs-list">
          {mf.azureRules.map((rule) => <li>{rule}</li>)}
        </ul>
      </section>

      <section id="config-priority" class="docs-section">
        <h2>{mf.priorityTitle}</h2>
        <p>{mf.priorityDesc}</p>
        <div class="priority-stack">
          <div class="priority-item priority-1">1. {mf.priority1}</div>
          <div class="priority-item priority-2">2. {mf.priority2}</div>
          <div class="priority-item priority-3">3. {mf.priority3}</div>
        </div>
        <p>{mf.priorityExplain}</p>
        <CodeBlock lang="bash" code={mfOverrideExample} />
        <p class="note">{mf.priorityGhaNote}</p>
      </section>

      <section id="validation" class="docs-section">
        <h2>{mf.validationTitle}</h2>
        <p>{mf.validationDesc}</p>
        <ul class="docs-list">
          {mf.validationRules.map((rule) => <li>{rule}</li>)}
        </ul>
      </section>

      <section id="secret-contents" class="docs-section">
        <h2>{t.docs.mapContentsTitle}</h2>
        <p>{t.docs.mapContentsIntro}</p>
        <table class="docs-table">
          <thead>
            <tr><th>{t.docs.mapThStage}</th><th>{t.docs.mapThLimit}</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>{t.docs.mapContentsProvider}</strong></td>
              <td>{t.docs.mapContentsProviderLimit}</td>
            </tr>
            <tr>
              <td><strong>{t.docs.mapContentsEnvFile}</strong></td>
              <td>{t.docs.mapContentsEnvFileLimit}</td>
            </tr>
            <tr>
              <td><strong>{t.docs.mapContentsProcess}</strong></td>
              <td>{t.docs.mapContentsProcessLimit}</td>
            </tr>
          </tbody>
        </table>
        <p>{t.docs.mapContentsResolveOnly}</p>

        <p>{t.docs.mapContentsWriterDesc}</p>
        <CodeBlock lang="dotenv" filename=".env" code={`PLAIN=plain
QUOTES=she said "hi"
HASH='alpha#beta'
PADDED='  padded  '
MULTILINE="first\\nsecond"`} />
        <p>{t.docs.mapContentsRoundTrip}</p>

        <div class="callout callout-warning">
          <span class="callout-icon">⚠️</span>
          <div>
            <strong>{t.docs.mapContentsUnrepresentableTitle}</strong> {t.docs.mapContentsUnrepresentableDesc}
          </div>
        </div>

        <div class="callout">
          <span class="callout-icon">💲</span>
          <div>
            <strong>{t.docs.mapContentsExpansionTitle}</strong> {t.docs.mapContentsExpansionDesc}
          </div>
        </div>
      </section>

      <section id="multi-environment" class="docs-section">
        <h2>{mf.multiEnvTitle}</h2>
        <p>{mf.multiEnvDesc}</p>
        <div class="multi-env-grid">
          <CodeBlock lang="json" filename="envilder.dev.json" code={mfDevExample} />
          <CodeBlock lang="json" filename="envilder.prod.json" code={mfProdExample} />
        </div>
        <p>{mf.multiEnvRun}</p>
        <CodeBlock lang="bash" code={mfMultiEnvCommands} />
        <p>{mf.multiEnvGha}</p>
        <CodeBlock lang="yaml" code={mfMultiEnvGha} />
        <p class="note">{mf.multiEnvNaming}</p>
      </section>

      <section id="map-errors" class="docs-section">
        <h2>{mf.errorsTitle}</h2>
        <table class="docs-table">
          <thead>
            <tr><th>{mf.thMessage}</th><th>{mf.thFix}</th></tr>
          </thead>
          <tbody>
            {mfErrors.map((row) => (
              <tr><td><code>{row.message}</code></td><td>{mf[row.fix]}</td></tr>
            ))}
          </tbody>
        </table>
      </section>

      <section id="map-related" class="docs-section">
        <h2>{mf.relatedTitle}</h2>
        <ul class="docs-list">
          <li><a href={localizedPath(lang, '/docs/getting-started/')}>{mf.relatedStart}</a></li>
          <li><a href={localizedPath(lang, '/docs/cli/exec/')}>{mf.relatedExec}</a></li>
          <li><a href={localizedPath(lang, '/docs/providers/azure-key-vault/')}>{mf.relatedAzure}</a></li>
        </ul>
      </section>
    </>
  )}

  {routeKey === 'cli-pull' && (
    <>
      <section id="pull-prerequisites" class="docs-section">
        <h2>{pr.prereqTitle}</h2>
        <ul class="docs-list">
          {pr.prereqItems.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section id="pull-synopsis" class="docs-section">
        <h2>{pr.synopsisTitle}</h2>
        <CodeBlock lang="bash" code={pullSynopsis} />
        <p>{pr.synopsisDesc}</p>
      </section>

      <section id="pull-command" class="docs-section">
        <h2>{pr.optionsTitle}</h2>
        <table class="docs-table">
          <thead>
            <tr><th>{pr.thOption}</th><th>{pr.thDefault}</th><th>{pr.thDescription}</th></tr>
          </thead>
          <tbody>
            <tr><td><code>--map</code></td><td>{pr.optMapDefault}</td><td>{pr.optMap}</td></tr>
            <tr><td><code>--envfile</code></td><td><code>.env</code></td><td>{pr.optEnvfile}</td></tr>
            <tr><td><code>--provider</code></td><td>{pr.optProviderDefault}</td><td>{pr.optProvider}</td></tr>
            <tr><td><code>--vault-url</code></td><td><code>$config.vaultUrl</code></td><td>{pr.optVault}</td></tr>
            <tr><td><code>--profile</code></td><td>{pr.optProfileDefault}</td><td>{pr.optProfile}</td></tr>
          </tbody>
        </table>
        <p class="note">{pr.optionsNote}</p>
      </section>

      <section id="pull-config" class="docs-section">
        <h2>{pr.configTitle}</h2>
        <p>{pr.configDesc}</p>
        <TabbedCodeBlock tabs={[
          { label: pr.tabAws, lang: 'json', filename: 'envilder.prod.json', code: pullConfigAwsMap },
          { label: pr.tabAzure, lang: 'json', filename: 'envilder.prod.json', code: pullConfigAzureMap },
        ]} />
        <p>{pr.configRun}</p>
        <TabbedCodeBlock tabs={[
          { label: pr.tabAws, lang: 'bash', code: pullConfigAwsCmd, note: pr.configAwsNote },
          { label: pr.tabAzure, lang: 'bash', code: pullConfigAzureCmd, note: pr.configAzureNote },
        ]} />
        <p><a href={localizedPath(lang, '/docs/map-file/#config-priority')}>{pr.configLink}</a></p>
      </section>

      <section id="pull-example" class="docs-section">
        <h2>{pr.exampleTitle}</h2>
        <p>{pr.exampleDesc}</p>
        <div class="multi-env-grid">
          <CodeBlock lang="json" filename="envilder.json" code={pullExampleMap} />
          <CodeBlock lang="dotenv" filename=".env" code={pullExampleEnvBefore} />
        </div>
        <p>{pr.exampleRun}</p>
        <CodeBlock lang="bash" code="envilder" />
        <CodeBlock lang="text" code={pullExampleOutput} />
        <p>{pr.exampleOutputNote}</p>
        <p>{pr.exampleResult}</p>
        <CodeBlock lang="dotenv" filename=".env" code={pullExampleEnvAfter} />
      </section>

      <section id="pull-env-file" class="docs-section">
        <h2>{pr.envTitle}</h2>
        <ul class="docs-list">
          {pr.envRules.map((rule) => <li>{rule}</li>)}
        </ul>
        <p>
          {pr.envNote}{' '}
          <a href={localizedPath(lang, '/docs/map-file/#secret-contents')}>{pr.envNoteLink}</a>
        </p>
        <div class="callout callout-warning">
          <span class="callout-icon">⚠️</span>
          <div>{pr.envWarn}</div>
        </div>
      </section>

      <section id="pull-missing" class="docs-section">
        <h2>{pr.missingTitle}</h2>
        <p>{pr.missingDesc}</p>
        <p>{pr.failDesc}</p>
        <CodeBlock lang="text" code={pullFailureOutput} />
        <p>{pr.ssoDesc}</p>
      </section>

      <section id="pull-errors" class="docs-section">
        <h2>{pr.errorsTitle}</h2>
        <table class="docs-table">
          <thead>
            <tr><th>{pr.thMessage}</th><th>{pr.thFix}</th></tr>
          </thead>
          <tbody>
            {pullErrors.map((row) => (
              <tr><td><code>{row.message}</code></td><td>{pr[row.fix]}</td></tr>
            ))}
          </tbody>
        </table>
      </section>

      <section id="pull-related" class="docs-section">
        <h2>{pr.relatedTitle}</h2>
        <ul class="docs-list">
          <li><a href={localizedPath(lang, '/docs/map-file/')}>{pr.relatedMap}</a></li>
          <li><a href={localizedPath(lang, '/docs/cli/exec/')}>{pr.relatedExec}</a></li>
          <li><a href={localizedPath(lang, '/docs/cli/push/')}>{pr.relatedPush}</a></li>
        </ul>
      </section>
    </>
  )}

  {routeKey === 'cli-push' && (
    <>
      <section id="push-prerequisites" class="docs-section">
        <h2>{pu.prereqTitle}</h2>
        <ul class="docs-list">
          {pu.prereqItems.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section id="push-synopsis" class="docs-section">
        <h2>{pu.synopsisTitle}</h2>
        <CodeBlock lang="bash" code={pushSynopsis} />
        <p>{pu.synopsisDesc}</p>
      </section>

      <section id="push-command" class="docs-section">
        <h2>{pu.envTitle}</h2>
        <p>{pu.envDesc}</p>
        <table class="docs-table">
          <thead>
            <tr><th>{pu.thOption}</th><th>{pu.thDefault}</th><th>{pu.thDescription}</th></tr>
          </thead>
          <tbody>
            <tr><td><code>--push</code></td><td>-</td><td>{pu.optPush}</td></tr>
            <tr><td><code>--envfile</code></td><td><code>.env</code></td><td>{pu.optEnvfile}</td></tr>
            <tr><td><code>--map</code></td><td><code>envilder.json</code></td><td>{pu.optMap}</td></tr>
            <tr><td><code>--provider</code>, <code>--vault-url</code>, <code>--profile</code></td><td><code>$config</code></td><td>{pu.optShared}</td></tr>
          </tbody>
        </table>
        <p>{pu.envExample}</p>
        <div class="multi-env-grid">
          <CodeBlock lang="json" filename="envilder.json" code={pushEnvMap} />
          <CodeBlock lang="dotenv" filename=".env" code={pushEnvFile} />
        </div>
        <CodeBlock lang="bash" code="envilder --push" />
        <CodeBlock lang="text" code={pushEnvOutput} />
        <ul class="docs-list">
          {pu.envRules.map((rule) => <li>{rule}</li>)}
        </ul>
      </section>

      <section id="push-single" class="docs-section">
        <h2>{pu.singleTitle}</h2>
        <p>{pu.singleDesc}</p>
        <table class="docs-table">
          <thead>
            <tr><th>{pu.thOption}</th><th>{pu.thDefault}</th><th>{pu.thDescription}</th></tr>
          </thead>
          <tbody>
            <tr><td><code>--key</code></td><td>-</td><td>{pu.optKey}</td></tr>
            <tr><td><code>--value</code></td><td>-</td><td>{pu.optValue}</td></tr>
            <tr><td><code>--secret-path</code></td><td>-</td><td>{pu.optSecretPath}</td></tr>
            <tr><td><code>--map</code></td><td><code>envilder.json</code></td><td>{pu.optMapSingle}</td></tr>
            <tr><td><code>--no-map-update</code></td><td>-</td><td>{pu.optNoMapUpdate}</td></tr>
          </tbody>
        </table>
        <p>{pu.singleExample}</p>
        <TabbedCodeBlock tabs={[
          { label: pu.tabAws, lang: 'bash', code: pushSingleAwsCmd },
          { label: pu.tabAzure, lang: 'bash', code: pushSingleAzureCmd },
