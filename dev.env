# Development environment variables for local containers
# Source: docker compose -f docker-compose.yml up -d

# AWS SSM (LocalStack)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Azure Key Vault (LocalStack for Azure on port 4567)
# Vault URLs look like https://<vault>.vault.azure.localhost.localstack.cloud:4567
# Create the vault and sign in through the Azure CLI with `lstk az start-interception`;
# DefaultAzureCredential then picks up the Azure CLI credential.
ENVILDER_ALLOWED_VAULT_HOSTS=localhost.localstack.cloud
